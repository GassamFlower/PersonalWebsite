---
// Timeline.astro — 档案 · 做过的事（垂直时间线 + 存档图标）
const nodes = [
  { year: '2018—2025', title: '政务系统技术支持', desc: '业务与数据，SQL、远程支持' },
  { year: '2025', title: '工业运维平台 OPS', desc: '从零搭建，Go+Next.js' },
  { year: '2025', title: '统一用户中心 UUC', desc: '企业内部 SSO 权限中台' },
  { year: '2026', title: '工程用车助手', desc: '外单微信小程序，已上线交付' },
  { year: '2026', title: 'Vibe Coding 方法论与知识库', desc: '给 AI 定规矩、留体系' },
];
---

<section id="timeline" class="section timeline">
  <div class="container">
    <p class="section-head"><span class="no">档案 03</span> · 做过的事</p>
    <h2 class="section-title">干过的活，<br />都有据可查</h2>
    <div class="tl">
      {
        nodes.map((n) => (
          <article class="tl-node">
            <span class="tl-marker" aria-hidden="true"></span>
            <div class="tl-body">
              <p class="tl-year">{n.year}</p>
              <h3 class="tl-title">{n.title}</h3>
              <p class="tl-desc">{n.desc}</p>
            </div>
          </article>
        ))
      }
    </div>
    <div class="tl-archive" aria-hidden="true">
      <!-- 存档图标：文件盒 + 印章 -->
      <svg viewBox="0 0 200 120" class="archive-svg">
        <!-- 文件盒 -->
        <rect x="10" y="20" width="120" height="80" rx="2" fill="none" stroke="var(--color-line)" stroke-width="1.5"/>
        <rect x="15" y="10" width="20" height="30" rx="1" fill="none" stroke="var(--color-line)" stroke-width="1"/>
        <rect x="40" y="10" width="20" height="30" rx="1" fill="none" stroke="var(--color-line)" stroke-width="1"/>
        <rect x="65" y="10" width="20" height="30" rx="1" fill="none" stroke="var(--color-line)" stroke-width="1"/>
        <!-- 文件 -->
        <rect x="20" y="30" width="100" height="60" rx="1" fill="none" stroke="var(--color-line)" stroke-width="0.8"/>
        <line x1="30" y1="45" x2="100" y2="45" stroke="var(--color-line)" stroke-width="0.5"/>
        <line x1="30" y1="55" x2="90" y2="55" stroke="var(--color-line)" stroke-width="0.5"/>
        <line x1="30" y1="65" x2="95" y2="65" stroke="var(--color-line)" stroke-width="0.5"/>
        <line x1="30" y1="75" x2="80" y2="75" stroke="var(--color-line)" stroke-width="0.5"/>
        <!-- 印章 -->
        <circle cx="150" cy="70" r="30" fill="none" stroke="var(--color-accent)" stroke-width="1.5"/>
        <circle cx="150" cy="70" r="24" fill="none" stroke="var(--color-accent)" stroke-width="0.8"/>
        <text x="138" y="75" font-size="14" fill="var(--color-accent)" font-weight="700">存档</text>
      </svg>
    </div>
  </div>
</section>

<style>
  .timeline {
    border-top: 1px solid var(--color-line);
  }
  .section-title {
    margin-bottom: var(--space-12);
  }
  .tl {
    position: relative;
    padding-left: var(--space-10);
  }
  .tl::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-line);
  }
  .tl-node {
    position: relative;
    padding-bottom: var(--space-10);
  }
  .tl-node:last-child {
    padding-bottom: 0;
  }
  .tl-marker {
    position: absolute;
    left: calc(-1 * var(--space-10) + 1px);
    top: 0.35em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .tl-body {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-6);
    align-items: baseline;
  }
  .tl-year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-highlight);
    letter-spacing: 0.06em;
  }
  .tl-title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0.01em;
    margin-bottom: var(--space-1);
  }
  .tl-desc {
    grid-column: 2;
    color: var(--color-line);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .tl-archive {
    margin-top: var(--space-12);
    padding-left: var(--space-10);
  }
  .archive-svg {
    width: 200px;
    height: auto;
  }
  @media (max-width: 640px) {
    .tl-body {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .tl-desc {
      grid-column: 1;
    }
  }
</style>

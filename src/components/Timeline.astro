---
// Timeline.astro — 参考图 3 · 做过的事
// 上方横细线 · 左上"档案 03 · 做过的事"
// 中间单列垂直时间线 + 圆点 + 年份/标题/描述
// 左下角三只档案盒（第二只半拉出）+ 圆形存档印章
const nodes = [
  { year: '2018—2025', title: '政务系统技术支持', desc: '业务与数据，SQL、远程支持' },
  { year: '2025', title: '工业运维平台 OPS', desc: '从零搭建，Go+Next.js' },
  { year: '2025', title: '统一用户中心 UUC', desc: '企业内部 SSO 权限中台' },
  { year: '2026', title: '工程用车助手', desc: '外单微信小程序，已上线交付' },
  { year: '2026', title: 'Vibe Coding 方法论与知识库', desc: '给 AI 定规矩、留体系' },
];
---

<section id="timeline" class="section timeline">
  <div class="container">
    <div class="section-head">
      <span class="tag"><b>档案 03</b> · 做过的事</span>
      <span class="meta">03</span>
    </div>
    <div class="tl-rule"></div>

    <h2 class="section-title tl-title">干过的活，<br/>都有据可查</h2>

    <div class="tl">
      {
        nodes.map((n) => (
          <article class="tl-node">
            <span class="tl-marker" aria-hidden="true"></span>
            <span class="tl-year">{n.year}</span>
            <h3 class="tl-title">{n.title}</h3>
            <p class="tl-desc">{n.desc}</p>
          </article>
        ))
      }
    </div>

    <!-- 左下角档案盒 + 存档印章 -->
    <div class="tl-art" aria-hidden="true">
      <svg viewBox="0 0 320 170" class="archive-svg">
        <!-- 顶部基准虚线 -->
        <line x1="10" y1="14" x2="220" y2="14" stroke="var(--color-faint)" stroke-width="0.6" stroke-dasharray="3 3"/>
        <!-- 中心线（点划线） -->
        <line x1="115" y1="14" x2="115" y2="156" stroke="var(--color-faint)" stroke-width="0.5" stroke-dasharray="6 1 1 1"/>

        <!-- 档案盒 1：闭合 -->
        <rect x="20" y="40" width="60" height="100" fill="none" stroke="var(--color-ink)" stroke-width="1.4"/>
        <rect x="32" y="52" width="36" height="6" fill="none" stroke="var(--color-faint)" stroke-width="0.6"/>
        <rect x="32" y="64" width="36" height="6" fill="none" stroke="var(--color-faint)" stroke-width="0.6"/>
        <!-- 档案盒 2：半拉出（露出文件） -->
        <rect x="86" y="40" width="60" height="100" fill="none" stroke="var(--color-ink)" stroke-width="1.4"/>
        <!-- 拉出的文件 -->
        <rect x="92" y="32" width="3" height="60" fill="none" stroke="var(--color-faint)" stroke-width="0.7"/>
        <rect x="100" y="28" width="3" height="68" fill="none" stroke="var(--color-line)" stroke-width="0.7"/>
        <rect x="108" y="34" width="3" height="60" fill="none" stroke="var(--color-faint)" stroke-width="0.7"/>
        <rect x="116" y="30" width="3" height="66" fill="none" stroke="var(--color-accent)" stroke-width="1"/>
        <rect x="124" y="32" width="3" height="62" fill="none" stroke="var(--color-faint)" stroke-width="0.7"/>
        <rect x="132" y="28" width="3" height="68" fill="none" stroke="var(--color-line)" stroke-width="0.7"/>
        <!-- 拉出抽屉的把手 -->
        <rect x="106" y="118" width="20" height="6" rx="1" fill="none" stroke="var(--color-ink)" stroke-width="0.8"/>
        <!-- 档案盒 3：闭合 -->
        <rect x="152" y="40" width="60" height="100" fill="none" stroke="var(--color-ink)" stroke-width="1.4"/>
        <rect x="164" y="52" width="36" height="6" fill="none" stroke="var(--color-faint)" stroke-width="0.6"/>
        <rect x="164" y="64" width="36" height="6" fill="none" stroke="var(--color-faint)" stroke-width="0.6"/>

        <!-- 存档印章 -->
        <g transform="translate(238 80)">
          <circle cx="34" cy="34" r="34" fill="none" stroke="var(--color-gold)" stroke-width="1.6"/>
          <circle cx="34" cy="34" r="28" fill="none" stroke="var(--color-gold)" stroke-width="0.7"/>
          <text x="34" y="42" text-anchor="middle" font-family="var(--font-serif)"
            font-size="18" fill="var(--color-gold)" font-weight="700">存档</text>
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .tl-rule {
    height: 1px;
    background: var(--color-ink);
    opacity: 0.85;
    margin-bottom: var(--space-12);
  }
  .tl-title {
    margin-bottom: var(--space-12);
  }
  .tl {
    position: relative;
    padding-left: var(--space-8);
    max-width: 640px;
  }
  .tl::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--color-ink);
    opacity: 0.7;
  }
  .tl-node {
    position: relative;
    padding-bottom: var(--space-10);
  }
  .tl-node:last-child { padding-bottom: 0; }
  .tl-marker {
    position: absolute;
    left: calc(-1 * var(--space-8) + 1px);
    top: 8px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: 0 0 0 3px var(--color-base);
  }
  .tl-year {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink);
    margin-bottom: var(--space-1);
    letter-spacing: 0.04em;
  }
  .tl-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-1);
  }
  .tl-desc {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-line);
    line-height: 1.7;
  }
  .tl-art {
    margin-top: var(--space-12);
  }
  .archive-svg {
    width: 320px;
    max-width: 100%;
    height: auto;
  }
</style>
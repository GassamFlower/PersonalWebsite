---
// Timeline.astro — 档案 03 · 做过的事（垂直时间线 + 环形文件夹 + 存档印章）
const nodes = [
  { year: '2018—2025', title: '政务系统技术支持', desc: '业务与数据，SQL、远程支持' },
  { year: '2025', title: '工业运维平台 OPS', desc: '从零搭建，Go+Next.js' },
  { year: '2025', title: '统一用户中心 UUC', desc: '企业内部 SSO 权限中台' },
  { year: '2026', title: '工程用车助手', desc: '外单微信小程序，已上线交付' },
  { year: '2026', title: 'Vibe Coding 方法论与知识库', desc: '给 AI 定规矩、留体系' },
];
---

<section id="timeline" class="section timeline">
  <div class="container">
    <div class="section-head">
      <span class="tag"><b>档案 03</b> · 做过的事</span>
      <span class="meta">03</span>
    </div>

    <h2 class="section-title">干过的活，<br />都有据可查</h2>

    <div class="tl">
      {
        nodes.map((n) => (
          <article class="tl-node">
            <span class="tl-marker" aria-hidden="true"></span>
            <div class="tl-body">
              <p class="tl-year">{n.year}</p>
              <div class="tl-main">
                <h3 class="tl-title">{n.title}</h3>
                <p class="tl-desc">{n.desc}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- 环形活页夹 + 存档印章（制图风） -->
    <div class="tl-archive" aria-hidden="true">
      <div class="archive-boxes">
        <svg viewBox="0 0 300 200" class="archive-svg">
          <!-- 三个环形档案盒，左为拉出状态 -->
          <g class="box-pull">
            <line x1="30" y1="28" x2="30" y2="168" stroke="var(--color-ink)" stroke-width="1.4"/>
            <line x1="78" y1="28" x2="78" y2="168" stroke="var(--color-ink)" stroke-width="1.4"/>
            <line x1="30" y1="168" x2="78" y2="168" stroke="var(--color-ink)" stroke-width="1.4"/>
            <line x1="30" y1="28" x2="78" y2="28" stroke="var(--color-ink)" stroke-width="1.4"/>
            <!-- 环扣 -->
            <circle cx="45" cy="40" r="10" fill="none" stroke="var(--color-line)" stroke-width="1.2"/>
            <circle cx="64" cy="40" r="10" fill="none" stroke="var(--color-line)" stroke-width="1.2"/>
          </g>
          <g class="box">
            <rect x="105" y="20" width="52" height="150" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="1.4"/>
            <circle cx="122" cy="30" r="8" fill="none" stroke="var(--color-line)" stroke-width="1.2"/>
            <circle cx="140" cy="30" r="8" fill="none" stroke="var(--color-line)" stroke-width="1.2"/>
            <line x1="112" y1="60" x2="150" y2="60" stroke="var(--color-faint)" stroke-width="0.7"/>
            <line x1="112" y1="80" x2="150" y2="80" stroke="var(--color-faint)" stroke-width="0.7"/>
            <line x1="112" y1="100" x2="150" y2="100" stroke="var(--color-faint)" stroke-width="0.7"/>
          </g>
          <g class="box">
            <rect x="172" y="20" width="52" height="150" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="1.4"/>
            <circle cx="189" cy="30" r="8" fill="none" stroke="var(--color-line)" stroke-width="1.2"/>
            <circle cx="207" cy="30" r="8" fill="none" stroke="var(--color-line)" stroke-width="1.2"/>
            <line x1="179" y1="60" x2="217" y2="60" stroke="var(--color-faint)" stroke-width="0.7"/>
            <line x1="179" y1="80" x2="217" y2="80" stroke="var(--color-faint)" stroke-width="0.7"/>
          </g>
          <g class="box">
            <rect x="239" y="20" width="52" height="150" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="1.4"/>
            <circle cx="256" cy="30" r="8" fill="none" stroke="var(--color-line)" stroke-width="1.2"/>
            <circle cx="274" cy="30" r="8" fill="none" stroke="var(--color-line)" stroke-width="1.2"/>
            <line x1="246" y1="60" x2="284" y2="60" stroke="var(--color-faint)" stroke-width="0.7"/>
          </g>
          <!-- 圆形"存档"印章（叠加右下） -->
          <g transform="translate(232,120)">
            <circle r="34" fill="none" stroke="var(--color-gold)" stroke-width="1.6"/>
            <circle r="28" fill="none" stroke="var(--color-gold)" stroke-width="0.8"/>
            <text text-anchor="middle" dy="5" font-size="15" fill="var(--color-gold)"
              font-family="var(--font-serif)" font-weight="700">存档</text>
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .tl {
    position: relative;
    padding-left: var(--space-12);
    max-width: 760px;
  }
  /* 垂直时间线 */
  .tl::before {
    content: "";
    position: absolute;
    left: var(--space-1);
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--color-ink);
  }
  .tl-node {
    position: relative;
    padding-bottom: var(--space-12);
  }
  .tl-node:last-child {
    padding-bottom: var(--space-8);
  }
  .tl-marker {
    position: absolute;
    left: calc(-1 * var(--space-12) + var(--space-1) - 4px);
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-base);
    border: 1.5px solid var(--color-ink);
  }
  .tl-body {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: var(--space-6);
    align-items: baseline;
  }
  .tl-year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-line);
    letter-spacing: 0.05em;
  }
  .tl-title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0.01em;
    margin-bottom: var(--space-1);
  }
  .tl-desc {
    color: var(--color-line);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .tl-archive {
    margin-top: var(--space-10);
    max-width: 760px;
  }
  .archive-svg {
    width: 300px;
    height: auto;
  }
  @media (max-width: 560px) {
    .tl-body {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .tl-main {
      grid-column: 1;
    }
  }
</style>
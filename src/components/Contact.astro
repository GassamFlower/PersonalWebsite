---
// Contact.astro — 档案 08 · 联系交流（居中布局 + 信封制图 + 铜金 CTA）
// 右上：信封 + 十字准星
// 居中：标题 + 单行联系（微信 + 3 邮箱） + 1 铜金按钮 + 副文
// 底部：slogan
const wechat = 'G10S7H21';
const emails = [
  '1462882928@qq.com',
  'luoyongui07@gmail.com',
  'dblandlyg@163.com',
];
---

<section id="contact" class="section contact">
  <div class="container contact-inner">
    <div class="section-head">
      <span class="tag"><b>档案 08</b> · 联系</span>
      <span class="meta">08</span>
    </div>
    <div class="ct-rule"></div>

    <!-- 右上：信封 + 十字准星 -->
    <div class="envelope-art" aria-hidden="true">
      <svg viewBox="0 0 140 120" class="envelope-svg">
        <!-- 十字准星（虚线对位） -->
        <line x1="70" y1="6" x2="70" y2="22" stroke="var(--color-line)" stroke-width="0.8" stroke-dasharray="2 2"/>
        <line x1="70" y1="96" x2="70" y2="114" stroke="var(--color-line)" stroke-width="0.8" stroke-dasharray="2 2"/>
        <line x1="6" y1="58" x2="22" y2="58" stroke="var(--color-line)" stroke-width="0.8" stroke-dasharray="2 2"/>
        <line x1="118" y1="58" x2="134" y2="58" stroke="var(--color-line)" stroke-width="0.8" stroke-dasharray="2 2"/>
        <!-- 信封主体（略微倾斜） -->
        <g transform="rotate(-8 70 58)">
          <rect x="22" y="34" width="96" height="50" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="1.6"/>
          <polyline points="22,36 70,68 118,36" fill="none" stroke="var(--color-ink)" stroke-width="1.6"/>
          <line x1="22" y1="84" x2="56" y2="58" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="118" y1="84" x2="84" y2="58" stroke="var(--color-line)" stroke-width="0.8"/>
        </g>
      </svg>
    </div>

    <h2 class="contact-title">聊得来，就一起做事</h2>

    <div class="contact-info">
      <span class="info-item"><b>微信</b>　{wechat}</span>
      <span class="info-sep">·</span>
      <span class="info-item"><b>邮箱</b></span>
      {
        emails.map((e) => (
          <>
            <a class="info-mail" href={`mailto:${e}`}>{e}</a>
            <span class="info-sep">|</span>
          </>
        ))
      }
    </div>

    <div class="contact-actions">
      <button class="btn btn-solid" data-copy={wechat}>加微信聊聊</button>
    </div>

    <p class="contact-note">雇主与过程细节对公开版隐去 · 详询索取 ↘</p>

    <p class="contact-slogan">PERSONAL DOSSIER · 把一团乱麻，理成能用的系统</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const val = btn.dataset.copy;
      if (!val) return;
      try {
        await navigator.clipboard.writeText(val);
        const original = btn.textContent;
        btn.textContent = '已复制 · ' + val;
        setTimeout(() => (btn.textContent = original), 1500);
      } catch {
        try {
          window.prompt('请手动复制微信号', val);
        } catch {
          /* 老环境：忽略 */
        }
      }
    });
  });
</script>

<style>
  .contact-inner {
    position: relative;
    text-align: center;
    padding-top: var(--space-2);
  }
  .ct-rule {
    height: 1px;
    background: var(--color-ink);
    opacity: 0.85;
    margin-bottom: var(--space-12);
  }
  /* 信封定位右上 */
  .envelope-art {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-4);
  }
  .envelope-svg {
    width: 120px;
    height: auto;
  }
  .contact-title {
    font-size: var(--text-4xl);
    letter-spacing: 0.01em;
    margin: 0 auto var(--space-8);
    font-family: var(--font-serif);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-ink);
  }
  .contact-info {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-10);
    font-size: var(--text-base);
    color: var(--color-ink);
  }
  .info-item b {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-line);
  }
  .info-sep {
    color: var(--color-faint);
    font-family: var(--font-mono);
  }
  .info-mail {
    color: var(--color-ink);
    transition: color 0.2s;
  }
  .info-mail:hover {
    color: var(--color-gold);
  }
  .contact-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }
  .btn-solid {
    background: var(--color-gold);
    color: var(--color-on-accent);
    padding: var(--space-4) var(--space-12);
    font-size: var(--text-base);
    border-radius: var(--radius);
    letter-spacing: 0.06em;
    transition: background-color 0.2s;
  }
  .btn-solid:hover {
    background: color-mix(in srgb, var(--color-gold) 88%, #000);
  }
  .contact-note {
    font-size: var(--text-sm);
    color: var(--color-line);
    margin-bottom: var(--space-16);
    letter-spacing: 0.04em;
  }
  .contact-slogan {
    font-size: var(--text-xs);
    color: var(--color-line);
    letter-spacing: 0.12em;
    font-family: var(--font-mono);
  }
  @media (max-width: 720px) {
    .envelope-art { justify-content: center; }
    .contact-title { font-size: var(--text-3xl); }
    .contact-info { font-size: var(--text-sm); }
  }
</style>

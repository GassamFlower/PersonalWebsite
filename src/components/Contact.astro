---
// Contact.astro — 档案 08 · 联系交流（居中布局 + 信封制图 + 铜金 CTA）
const wechat = 'G10S7H21';
const emails = ['1462882928@qq.com'];
const phone = '+86 138 0000 0000';
---

<section id="contact" class="section contact">
  <div class="container contact-inner">
    <div class="section-head">
      <span class="tag"><b>档案 08</b> · 联系</span>
      <span class="meta">08</span>
    </div>

    <!-- 信封线稿（右上 · 十字准星虚线对齐） -->
    <div class="envelope-art" aria-hidden="true">
      <svg viewBox="0 0 120 100" class="envelope-svg">
        <line x1="60" y1="4" x2="60" y2="18" stroke="var(--color-line)" stroke-width="0.8" stroke-dasharray="2 2"/>
        <line x1="60" y1="82" x2="60" y2="96" stroke="var(--color-line)" stroke-width="0.8" stroke-dasharray="2 2"/>
        <line x1="4" y1="50" x2="18" y2="50" stroke="var(--color-line)" stroke-width="0.8" stroke-dasharray="2 2"/>
        <line x1="102" y1="50" x2="116" y2="50" stroke="var(--color-line)" stroke-width="0.8" stroke-dasharray="2 2"/>
        <rect x="20" y="30" width="80" height="42" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="1.5"/>
        <polyline points="20,32 60,58 100,32" fill="none" stroke="var(--color-ink)" stroke-width="1.5"/>
        <line x1="20" y1="72" x2="47" y2="51" stroke="var(--color-line)" stroke-width="0.8"/>
        <line x1="100" y1="72" x2="73" y2="51" stroke="var(--color-line)" stroke-width="0.8"/>
      </svg>
    </div>

    <h2 class="contact-title">聊得来，就一起做事</h2>

    <div class="contact-info">
      <span class="info-item"><b>微信</b>　{wechat}</span>
      <span class="info-sep">·</span>
      <span class="info-item"><b>邮箱</b>　{emails[0]}</span>
      <span class="info-sep">·</span>
      <span class="info-item"><b>手机</b>　{phone}</span>
    </div>

    <div class="contact-actions">
      <button class="btn btn-solid" data-copy={wechat}>加微信聊聊</button>
      <a class="btn btn-ghost" href={`mailto:${emails[0]}`}>写邮件 ↗</a>
    </div>

    <p class="contact-note">雇主与过程细节对公开版隐去 · 详询索取 ↘</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const val = btn.dataset.copy;
      if (!val) return;
      try {
        await navigator.clipboard.writeText(val);
        const original = btn.textContent;
        btn.textContent = '已复制 · ' + val;
        setTimeout(() => (btn.textContent = original), 1500);
      } catch {
        try {
          window.prompt('请手动复制微信号', val);
        } catch {
          /* 老环境：忽略 */
        }
      }
    });
  });
</script>

<style>
  .contact-inner {
    position: relative;
    text-align: center;
    padding-top: var(--space-10);
  }
  .contact-inner .section-head {
    position: absolute;
    top: var(--space-10);
    left: var(--gutter);
    right: var(--gutter);
  }
  .envelope-art {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-8);
  }
  .envelope-svg {
    width: 96px;
    height: auto;
  }
  .contact-title {
    font-size: var(--text-4xl);
    letter-spacing: 0.01em;
    margin: 0 auto var(--space-10);
  }
  .contact-info {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-10);
    font-size: var(--text-base);
  }
  .info-item b {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-line);
  }
  .info-sep {
    color: var(--color-faint);
  }
  .contact-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-12);
  }
  .btn-solid {
    background: var(--color-gold);
    color: #fbf8f1;
    padding: var(--space-4) var(--space-10);
    font-size: var(--text-base);
  }
  .btn-ghost {
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    padding: var(--space-4) var(--space-8);
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover {
    border-color: var(--color-ink);
  }
  .contact-note {
    font-size: var(--text-sm);
    color: var(--color-line);
  }
  @media (max-width: 560px) {
    .contact-title {
      font-size: var(--text-3xl);
    }
  }
</style>
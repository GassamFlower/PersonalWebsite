---
// Principles.astro — 档案 07 · 做事的规矩（四圆节点流程 + 末端对勾章 + 橡皮图章制图）
const gates = [
  { no: '01', title: '一 · 立项门', desc: '先把话说清楚，再动手' },
  { no: '02', title: '二 · 架构门', desc: '参考图为准绳，不凭感觉' },
  { no: '03', title: '三 · 业务门', desc: '素材有清单，证据才能过' },
  { no: '04', title: '四 · 上线门', desc: '可访问、可追溯、可复盘' },
];
---

<section id="principles" class="section principles">
  <div class="container">
    <div class="section-head">
      <span class="tag"><b>档案 07</b> · 做事的规矩</span>
      <span class="meta">07</span>
    </div>

    <h2 class="section-title principles-title">
      先立规矩，再让 <span class="ai">AI</span> 干活
    </h2>

    <!-- 水平四节点流程 + 末端对勾圆章 -->
    <div class="flow">
      {
        gates.map((g, i) => (
          <div class="flow-node">
            <div class="node-bubble">
              <span class="node-no">{g.no}</span>
            </div>
            <h3 class="flow-title">{g.title}</h3>
            <p class="flow-desc">{g.desc}</p>
          </div>
        ))
      }
      <div class="flow-finish">
        <div class="finish-bubble" aria-hidden="true">
          <svg viewBox="0 0 60 60">
            <!-- 十字准星定位标记 -->
            <line x1="30" y1="2" x2="30" y2="13" stroke="var(--color-ink)" stroke-width="1"/>
            <line x1="30" y1="47" x2="30" y2="58" stroke="var(--color-ink)" stroke-width="1"/>
            <line x1="2" y1="30" x2="13" y2="30" stroke="var(--color-ink)" stroke-width="1"/>
            <line x1="47" y1="30" x2="58" y2="30" stroke="var(--color-ink)" stroke-width="1"/>
            <circle cx="30" cy="30" r="21" fill="none" stroke="var(--color-ink)" stroke-width="1.5"/>
            <polyline points="20,31 27,38 41,23" fill="none"
              stroke="var(--color-accent)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <p class="finish-label">过站通过</p>
      </div>
    </div>

    <hr class="principles-hr" />

    <!-- 横躺橡皮图章制图（technical blueprint 风） -->
    <div class="stamp-row">
      <p class="principles-note">知识库与工作台分离，文档前缀排序，单一信源 SSOT。</p>
      <div class="stamp-art" aria-hidden="true">
        <svg viewBox="0 0 220 130" class="stamp-svg">
          <!-- 基准虚线 -->
          <line x1="8" y1="30" x2="212" y2="30" class="ghost-line"/>
          <line x1="8" y1="96" x2="212" y2="96" class="ghost-line"/>
          <!-- 印章底座：横躺（侧面视角） -->
          <rect x="50" y="30" width="120" height="66" rx="4" fill="none" stroke="var(--color-ink)" stroke-width="1.6"/>
          <!-- 印面刻字 -->
          <rect x="58" y="38" width="104" height="50" rx="2" fill="none" stroke="var(--color-line)" stroke-width="0.8"/>
          <text x="110" y="62" font-size="12" fill="var(--color-ink)" font-family="serif" font-weight="700"
            text-anchor="middle">档案 · 通过</text>
          <text x="110" y="78" font-size="7" fill="var(--color-line)" font-family="monospace"
            text-anchor="middle">APPROVED · NO.005</text>
          <!-- 柄：横圆柱 -->
          <rect x="72" y="14" width="76" height="20" rx="9" fill="none" stroke="var(--color-ink)" stroke-width="1.4"/>
          <line x1="72" y1="24" x2="148" y2="24" stroke="var(--color-ink)" stroke-width="1"/>
          <!-- 尺寸标注（顶部长度） -->
          <line x1="28" y1="8" x2="192" y2="8" stroke="var(--color-line)" stroke-width="0.7"/>
          <line x1="50" y1="3" x2="50" y2="13" stroke="var(--color-line)" stroke-width="0.7"/>
          <line x1="170" y1="3" x2="170" y2="13" stroke="var(--color-line)" stroke-width="0.7"/>
          <text x="96" y="24" font-size="8" fill="var(--color-line)" font-family="monospace">120</text>
          <!-- 中心线 -->
          <line x1="110" y1="30" x2="110" y2="96" class="center-line"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .principles-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-16);
  }
  /* "AI" 轻字重 —— 参考图做规矩标题 */
  .ai {
    font-family: var(--font-sans);
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .flow {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .flow-node {
    flex: 1 1 160px;
    max-width: 220px;
    text-align: center;
    padding: 0 var(--space-3);
    position: relative;
  }
  .node-bubble {
    width: 92px;
    height: 92px;
    margin: 0 auto var(--space-5);
    border-radius: 50%;
    border: 1.5px solid var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-base);
  }
  .node-no {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-gold);
  }
  .flow-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  .flow-desc {
    font-size: var(--text-sm);
    color: var(--color-line);
    line-height: 1.7;
  }
  /* 节点间箭头 */
  .flow-node + .flow-node::before,
  .flow-finish::before {
    content: "→";
    position: absolute;
    left: -0.5rem;
    top: 34px;
    color: var(--color-line);
    font-size: var(--text-xl);
  }
  .flow-finish {
    flex: 1 1 120px;
    max-width: 140px;
    text-align: center;
    padding: 0 var(--space-3);
    position: relative;
  }
  .finish-bubble {
    width: 92px;
    height: 92px;
    margin: 0 auto var(--space-5);
  }
  .finish-bubble svg {
    width: 100%;
    height: 100%;
  }
  .finish-label {
    font-size: var(--text-sm);
    color: var(--color-line);
  }

  .principles-hr {
    border: 0;
    border-top: 1px solid var(--color-ink);
    margin-top: var(--space-16);
  }
  .stamp-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
    margin-top: var(--space-10);
    flex-wrap: wrap;
  }
  .principles-note {
    font-size: var(--text-sm);
    color: var(--color-line);
    letter-spacing: 0.02em;
    max-width: 30em;
    line-height: 1.8;
  }
  .stamp-art {
    display: flex;
    justify-content: flex-end;
  }
  .stamp-svg {
    width: 220px;
    height: auto;
  }
  @media (max-width: 760px) {
    .flow {
      flex-direction: column;
      align-items: stretch;
      max-width: 380px;
    }
    .flow-node,
    .flow-finish {
      flex: none;
      max-width: none;
      text-align: left;
      display: grid;
      grid-template-columns: 3rem 1fr;
      gap: var(--space-4);
      align-items: center;
    }
    .node-bubble,
    .finish-bubble {
      width: 60px;
      height: 60px;
      margin: 0;
      grid-row: span 2;
    }
    .node-no {
      font-size: var(--text-2xl);
    }
    .flow-node + .flow-node::before,
    .flow-finish::before {
      content: none;
    }
  }
</style>
---
// Principles.astro — 档案 07 · 做事的规矩（参考图 7）
// 标题"先立规矩，再让 AI 干活"特大衬线
// 4 阶段：顶部大铜金编号 + 标题 + 水平线圆圈 + 描述
// 水平线：4 个空心圆圈 + 末端大对勾章（带十字准星）
// 底部：知识库说明 + 右下立着等轴测橡皮图章
const gates = [
  { no: '01', title: '一 · 立项门', desc: '先把话说清楚，\n再动手' },
  { no: '02', title: '二 · 架构门', desc: '参考图为准绳，\n不凭感觉' },
  { no: '03', title: '三 · 业务门', desc: '素材有清单，\n证据才能过' },
  { no: '04', title: '四 · 上线门', desc: '可访问、可追溯、\n可复盘' },
];
---

<section id="principles" class="section principles">
  <div class="container">
    <div class="section-head">
      <span class="tag"><b>档案 07</b> · 做事的规矩</span>
      <span class="meta">07</span>
    </div>
    <div class="pr-rule"></div>

    <h2 class="pr-mega">先立规矩，<br/>再让 <span class="ai">AI</span> 干活</h2>

    <!-- 4 阶段：编号 + 标题 + 连接线(圆点) + 描述 + 末端对勾章 -->
    <div class="flow">
      <div class="stages">
        {
          gates.map((g) => (
            <div class="stage">
              <span class="stage-no">{g.no}</span>
              <h3 class="stage-title">{g.title}</h3>
            </div>
          ))
        }
      </div>

      <!-- 连接线：纯 CSS 网格对齐，圆点自然居中于每个阶段列下，杜绝错位 -->
      <div class="flow-line" aria-hidden="true">
        <span class="gray-rail"></span>
        <span class="node "></span>
        <span class="node "></span>
        <span class="node "></span>
        <span class="node "></span>
        <span class="finish" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="finish-svg">
            <circle cx="12" cy="12" r="11" fill="var(--color-base)" stroke="var(--color-accent)" stroke-width="1.4"/>
            <polyline points="6,12 10.5,16.5 18,8" fill="none"
              stroke="var(--color-accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>

      <!-- 4 段描述（水平线下方，与编号同列对齐） -->
      <div class="descs">
        {
          gates.map((g) => (
            <div class="desc">
              {g.desc.split('\n').map((line) => (
                <p class="line">{line}</p>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="pr-foot">
      <p class="pr-note">知识库与工作台分离，文档前缀排序，单一信源 SSOT。</p>
      <div class="stamp-art" aria-hidden="true">
        <!-- 立着的橡皮图章（等轴测） -->
        <svg viewBox="0 0 200 220" class="stamp-svg">
          <!-- 中心线（点划线） -->
          <line x1="100" y1="10" x2="100" y2="210" stroke="var(--color-faint)" stroke-width="0.5" stroke-dasharray="6 1 1 1"/>
          <!-- 顶部手柄（立着） -->
          <rect x="80" y="14" width="40" height="22" rx="4" fill="none" stroke="var(--color-ink)" stroke-width="1.4"/>
          <line x1="80" y1="22" x2="120" y2="22" stroke="var(--color-ink)" stroke-width="0.8"/>
          <!-- 中段连接 -->
          <rect x="86" y="36" width="28" height="6" fill="none" stroke="var(--color-ink)" stroke-width="1"/>
          <!-- 印章主体（立着、略微下宽） -->
          <polygon points="76,46 124,46 130,180 70,180" fill="none" stroke="var(--color-ink)" stroke-width="1.6"/>
          <!-- 印面（底面，带刻字） -->
          <rect x="74" y="178" width="52" height="14" rx="1" fill="none" stroke="var(--color-ink)" stroke-width="1.4"/>
          <!-- 印面刻字 -->
          <text x="100" y="120" text-anchor="middle" font-family="var(--font-serif)" font-size="14"
            fill="var(--color-ink)" font-weight="700" letter-spacing="0.2em">档案</text>
          <text x="100" y="142" text-anchor="middle" font-family="var(--font-serif)" font-size="14"
            fill="var(--color-ink)" font-weight="700" letter-spacing="0.2em">通过</text>
          <line x1="86" y1="155" x2="114" y2="155" stroke="var(--color-line)" stroke-width="0.7"/>
          <text x="100" y="170" text-anchor="middle" font-family="monospace" font-size="7"
            fill="var(--color-line)" letter-spacing="0.15em">APPROVED</text>
          <!-- 基准虚线（底） -->
          <line x1="30" y1="206" x2="170" y2="206" stroke="var(--color-faint)" stroke-width="0.5" stroke-dasharray="3 3"/>
          <text x="100" y="218" text-anchor="middle" font-family="monospace" font-size="7"
            fill="var(--color-line)" letter-spacing="0.1em">NO.005</text>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .pr-rule {
    height: 1px;
    background: var(--color-ink);
    opacity: 0.85;
    margin-bottom: var(--space-12);
  }
  /* 特大衬线主标题 —— 参考图 7（统一口径：--text-mega） */
  .pr-mega {
    font-family: var(--font-serif);
    font-size: var(--text-mega);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    margin: 0 0 var(--space-10);
  }
  .ai {
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }

  /* 4 阶段流：竖向三段（标题行 / 连接线 / 描述行），列宽由 4 等分统一 */
  .flow {
    display: grid;
    gap: var(--space-4);
  }

  /* 标题行：4 等分，编号 + 标题（编号内联小标，不再单独成段） */
  .stages {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }
  .stage {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: var(--space-2);
  }
  /* 编号收为 0.85rem 内联小标，做装饰性索引，不再霸占视觉重量 */
  .stage-no {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-gold);
    letter-spacing: 0.08em;
    opacity: 0.85;
    flex-shrink: 0;
  }
  .stage-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: 0.01em;
    line-height: 1.3;
    text-wrap: balance;
  }

  /* 连接线：4 圆点 + 贯穿灰线 + 末端对勾章（CSS 网格对齐，天然居中不错位） */
  .flow-line {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr) auto;
    align-items: center;
    padding: var(--space-2) 0;
  }
  .gray-rail {
    position: absolute;
    left: 0;
    right: 60px;                 /* 给末端对勾章留位 */
    top: 50%;
    height: 1px;
    transform: translateY(-50%);
    background: var(--color-ink);
    opacity: 0.55;
  }
  .flow-line .node {
    position: relative;
    width: 11px;
    height: 11px;
    margin-inline: auto;
    border-radius: 50%;
    background: var(--color-base);
    border: 1.6px solid var(--color-accent);
    z-index: 1;
  }
  .flow-line .finish {
    position: relative;
    justify-self: end;
    z-index: 1;
  }
  .finish-svg {
    width: 30px;
    height: 30px;
    display: block;
  }

  /* 描述行：与标题行同列数对齐 */
  .descs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    border-top: 1px solid var(--color-faint);
    padding-top: var(--space-5);
  }
  .desc {
    font-size: var(--text-sm);
    line-height: 1.8;
    color: var(--color-line);
    white-space: pre-line;
    letter-spacing: 0.02em;
    padding-right: var(--space-4);
  }
  .desc .line { display: block; margin: 0; }

  /* 底部：知识库说明 + 立着图章 */
  .pr-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-12);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-ink);
  }
  .pr-note {
    font-size: var(--text-sm);
    color: var(--color-line);
    letter-spacing: 0.04em;
    max-width: 36em;
    line-height: 1.8;
  }
  .stamp-art { flex-shrink: 0; }
  .stamp-svg { width: 150px; height: auto; }

  @media (max-width: 960px) {
    .flow { gap: var(--space-5); }
    .stages, .descs { grid-template-columns: repeat(2, 1fr); gap: var(--space-6) var(--space-4); }
    .flow-line { grid-template-columns: repeat(4, 1fr) auto; }
  }
  @media (max-width: 560px) {
    .stages, .descs { grid-template-columns: 1fr; }
    .flow-line { display: none; } /* 窄屏舍去连接线，避免被挤扁 */
    .pr-foot { flex-direction: column; align-items: flex-start; gap: var(--space-6); }
    /* 手机端主标题收敛字号 + 放开行高，避免"先立规矩/再让 AI 干活"拥挤偏大 */
    .pr-mega {
      font-size: 1.8rem;
      line-height: 1.3;
      letter-spacing: 0.02em;
      margin-bottom: var(--space-8);
      text-wrap: balance;
    }
    .stage-no { font-size: 0.78rem; }
    .stage-title { font-size: 1.05rem; }
  }
</style>

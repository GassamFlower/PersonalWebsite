---
// SiteNav.astro — 全局导航（锚点 + 平滑滚动）
// 纯静态锚点跳转，无 JS；移动端用横向滚动折叠友好。
const navItems = [
  { href: '#timeline', label: '做过的事' },
  { href: '#cases', label: '项目' },
  { href: '#capability', label: '能力' },
  { href: '#growth', label: '成长' },
  { href: '#principles', label: '规矩' },
  { href: '#contact', label: '联系' },
];
---

<header class="site-nav">
  <div class="container nav-inner">
    <a class="brand" href="#hero">
      <span class="brand-mark">档案</span>
      <span class="brand-sub">PERSONAL DOSSIER</span>
    </a>
    <nav class="nav-links" aria-label="主导航">
      {
        navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-base) 88%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    white-space: nowrap;
  }
  .brand-mark {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--color-highlight);
    font-size: var(--text-lg);
  }
  .brand-sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }
  .nav-links {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav-links::-webkit-scrollbar {
    display: none;
  }
  .nav-links a {
    font-size: var(--text-sm);
    color: var(--color-ink);
    opacity: 0.75;
    white-space: nowrap;
    transition: opacity 0.2s, color 0.2s;
  }
  .nav-links a:hover {
    opacity: 1;
    color: var(--color-accent);
  }
  @media (max-width: 640px) {
    .nav-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
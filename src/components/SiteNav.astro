---
// SiteNav.astro — 极简导航：品牌字 + 6 锚点 + 绿点"在线"
const navItems = [
  { href: '#timeline', label: '做过的事' },
  { href: '#cases', label: '项目' },
  { href: '#capability', label: '能力' },
  { href: '#growth', label: '成长' },
  { href: '#principles', label: '规矩' },
  { href: '#contact', label: '联系' },
];
---

<header class="site-nav">
  <div class="container nav-inner">
    <a class="brand" href="#hero">
      PERSONAL DOSSIER <span class="brand-dot">·</span> 独立交付档案
    </a>
    <nav class="nav-links" aria-label="主导航">
      {
        navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
      <span class="nav-status">
        <span class="status-dot" aria-hidden="true"></span>在线
      </span>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-base) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-ink);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  .brand {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    font-weight: 500;
    white-space: nowrap;
  }
  .brand-dot {
    color: var(--color-line);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav-links::-webkit-scrollbar {
    display: none;
  }
  .nav-links a {
    font-size: var(--text-sm);
    color: var(--color-ink);
    opacity: 0.72;
    white-space: nowrap;
    transition: opacity 0.2s, color 0.2s;
  }
  .nav-links a:hover {
    opacity: 1;
    color: var(--color-accent);
  }
  .nav-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink);
    white-space: nowrap;
  }
  /* 在线绿点 —— 参考图首屏"● 在线" */
  .status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 20%, transparent);
    display: inline-block;
  }
  @media (max-width: 760px) {
    .nav-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .nav-links {
      width: 100%;
    }
  }
</style>
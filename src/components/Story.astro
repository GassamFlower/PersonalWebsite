---
// Story.astro — 档案 02 · 品牌故事（左文 / 右斜拉桥工程制图）
const paragraphs = [
  '八年政务系统维护，让我懂业务、懂数据，也看见系统背后真实的需求与约束。',
  '进入一家工业类企业，我看见长期被忽视的数字化空白——流程割裂、数据孤岛、体验落后。',
  '我从零搭起工业运维平台 OPS 与统一用户中心 UUC，让数据流动，让一线可用，让管理可视。',
  '靠强烈的好奇心与持续学习的劲头，我把系统做深、做实用；已经能上手 AI 落地（RAG、知识库、智能体），仍在往更深之处精进。',
  '我自建「五级项目体系 + 单一信源 SSOT」的做事规矩，以结构化的方法，把复杂的事做成可持续的系统。',
];
---

<section id="story" class="section story">
  <div class="container">
    <div class="section-head">
      <span class="tag"><b>档案 02</b> · 品牌故事</span>
      <span class="meta">02</span>
    </div>

    <div class="story-grid">
      <div class="story-body">
        {
          paragraphs.map((p) => (
            <p class="story-para">{p}</p>
          ))
        }
      </div>

      <div class="story-art" aria-hidden="true">
        <!-- 斜拉桥工程制图：V面线中心线 / 虚线基准 / 尺寸线 / V形墩 -->
        <svg viewBox="0 0 460 560" class="bridge-svg">
          <!-- 垂直中心线（点划线） -->
          <line x1="230" y1="20" x2="230" y2="520" class="center-line"/>
          <!-- 顶部基准虚线 -->
          <line x1="20" y1="60" x2="440" y2="60" class="ghost-line"/>
          <!-- 桥面基准虚线 -->
          <line x1="20" y1="330" x2="440" y2="330" class="ghost-line"/>
          <!-- 地面线 -->
          <line x1="20" y1="440" x2="440" y2="440" stroke="var(--color-line)"/>

          <!-- 桥塔（主结构实线） -->
          <line x1="230" y1="60" x2="230" y2="420" stroke="var(--color-ink)" stroke-width="2.5"/>
          <line x1="226" y1="60" x2="234" y2="60" stroke="var(--color-ink)" stroke-width="2.5"/>

          <!-- 扇形拉索（左） -->
          <line x1="230" y1="90" x2="70" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="230" y1="120" x2="95" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="230" y1="150" x2="120" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="230" y1="180" x2="145" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="230" y1="210" x2="170" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="230" y1="240" x2="195" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>
          <!-- 扇形拉索（右） -->
          <line x1="230" y1="90" x2="390" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="230" y1="120" x2="365" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="230" y1="150" x2="340" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="230" y1="180" x2="315" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="230" y1="210" x2="290" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="230" y1="240" x2="265" y2="332" stroke="var(--color-line)" stroke-width="0.8"/>

          <!-- 桥面 -->
          <line x1="20" y1="330" x2="440" y2="330" stroke="var(--color-ink)" stroke-width="2"/>
          <line x1="28" y1="337" x2="432" y2="337" stroke="var(--color-line)" stroke-width="0.8"/>

          <!-- V形桥墩 -->
          <line x1="230" y1="330" x2="182" y2="440" stroke="var(--color-ink)" stroke-width="1.6"/>
          <line x1="230" y1="330" x2="278" y2="440" stroke="var(--color-ink)" stroke-width="1.6"/>

          <!-- 承台 + 桩基 -->
          <line x1="150" y1="440" x2="310" y2="440" stroke="var(--color-ink)" stroke-width="1.6"/>
          <line x1="182" y1="440" x2="182" y2="470" stroke="var(--color-line)" stroke-width="1"/>
          <line x1="230" y1="440" x2="230" y2="470" stroke="var(--color-line)" stroke-width="1"/>
          <line x1="278" y1="440" x2="278" y2="470" stroke="var(--color-line)" stroke-width="1"/>
          <line x1="165" y1="470" x2="295" y2="470" stroke="var(--color-line)" stroke-width="1"/>

          <!-- 尺寸标注：跨长 -->
          <line x1="30" y1="520" x2="430" y2="520" class="dim-line"/>
          <line x1="30" y1="514" x2="30" y2="526" stroke="var(--color-line)" stroke-width="1"/>
          <line x1="430" y1="514" x2="430" y2="526" stroke="var(--color-line)" stroke-width="1"/>
          <text x="180" y="536" font-size="10" fill="var(--color-line)" font-family="monospace">跨度 4200</text>

          <!-- 尺寸标注：塔高 -->
          <line x1="300" y1="60" x2="300" y2="420" stroke="var(--color-line)" stroke-width="0.8"/>
          <line x1="294" y1="60" x2="306" y2="60" stroke="var(--color-line)" stroke-width="1"/>
          <line x1="294" y1="420" x2="306" y2="420" stroke="var(--color-line)" stroke-width="1"/>
          <text x="305" y="245" font-size="10" fill="var(--color-line)" font-family="monospace">塔高 3600</text>
        </svg>
      </div>
    </div>

    <div class="story-footer">
      <span>FILE 02 / 06</span>
      <span>DATE 2025-08-19</span>
      <span>BY YIYI</span>
    </div>
  </div>
</section>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  /* 中间细垂直分隔线 —— 参考图品牌故事分栏 */
  .story-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-16) var(--space-12) var(--space-16) 0;
    border-right: 1px solid var(--color-line);
  }
  .story-para {
    font-size: var(--text-lg);
    line-height: 1.9;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }
  .story-art {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16) 0 var(--space-16) var(--space-12);
  }
  .bridge-svg {
    width: 100%;
    max-width: 400px;
    height: auto;
  }
  .story-footer {
    display: flex;
    gap: var(--space-12);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-line);
    letter-spacing: 0.12em;
  }
  @media (max-width: 860px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
    .story-body {
      border-right: none;
      padding: var(--space-8) 0;
    }
    .story-art {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .story-para {
      font-size: var(--text-base);
    }
    .story-footer {
      gap: var(--space-6);
      flex-wrap: wrap;
    }
  }
</style>
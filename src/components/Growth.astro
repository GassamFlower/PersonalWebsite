---
// Growth.astro — 档案 06 · 成长记录
// 左：主标题 + 副标 + 黑白柱状+上升箭头 · 右：8 条月度列表
// 右上子导航：档案 / 作品 / 方法 / 记录 / 关于 + →
import { getCollection } from 'astro:content';

const posts = (await getCollection('growth')).sort((a, b) =>
  a.data.month < b.data.month ? 1 : -1
);
const subNav = [
  { href: '#hero', label: '档案' },
  { href: '#cases', label: '作品' },
  { href: '#principles', label: '方法' },
  { href: '#growth', label: '记录' },
  { href: '#contact', label: '关于' },
];
---

<section id="growth" class="section growth">
  <div class="container">
    <div class="section-head">
      <span class="tag"><b>档案 06</b> · 成长记录</span>
      <div class="right-nav">
        {subNav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a class="right-arrow" href="#contact" aria-label="下一页">→</a>
      </div>
    </div>
    <div class="growth-rule"></div>

    <div class="growth-grid">
      <div class="growth-left">
        <h2 class="section-title growth-title">公开的成长，<br/>一个月记一次</h2>
        <p class="growth-sub">给自己一个月进步的交代</p>
        <!-- 黑白柱状 + 上升趋势线（参考图成长单色图） -->
        <div class="growth-chart" aria-hidden="true">
          <svg viewBox="0 0 320 220">
            <!-- 坐标轴 -->
            <line x1="24" y1="180" x2="304" y2="180" stroke="var(--color-ink)" stroke-width="1"/>
            <line x1="24" y1="20" x2="24" y2="180" stroke="var(--color-ink)" stroke-width="1"/>
            <!-- 8 根柱 -->
            <rect x="40"  y="172" width="20" height="8" opacity="0.32"/>
            <rect x="76"  y="160" width="20" height="20" opacity="0.40"/>
            <rect x="112" y="146" width="20" height="34" opacity="0.50"/>
            <rect x="148" y="128" width="20" height="52" opacity="0.60"/>
            <rect x="184" y="106" width="20" height="74" opacity="0.72"/>
            <rect x="220" y="82"  width="20" height="98" opacity="0.84"/>
            <rect x="256" y="58"  width="20" height="122" opacity="0.95"/>
            <rect x="292" y="34"  width="20" height="146" opacity="1"/>
            <!-- 趋势折线（穿过所有柱顶） -->
            <polyline points="50,168 86,154 122,140 158,122 194,100 230,76 266,52 302,28"
              fill="none" stroke="var(--color-accent)" stroke-width="1.6"/>
            <!-- 上升箭头 -->
            <polyline points="294,30 302,28 300,36" fill="none" stroke="var(--color-accent)" stroke-width="1.6" stroke-linecap="round"/>
            <!-- 折线节点圆圈 -->
            <circle cx="50"  cy="168" r="2.5" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1.2"/>
            <circle cx="86"  cy="154" r="2.5" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1.2"/>
            <circle cx="122" cy="140" r="2.5" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1.2"/>
            <circle cx="158" cy="122" r="2.5" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1.2"/>
            <circle cx="194" cy="100" r="2.5" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1.2"/>
            <circle cx="230" cy="76"  r="2.5" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1.2"/>
            <circle cx="266" cy="52"  r="2.5" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1.2"/>
            <circle cx="302" cy="28"  r="2.5" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1.2"/>
          </svg>
        </div>
      </div>

      <div class="growth-list">
        {
          posts.map((p) => (
            <article class="growth-item">
              <span class="growth-month">{p.data.month}</span>
              <p class="growth-takeaway">{p.data.takeaway}</p>
              <span class="growth-arrow">→</span>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .growth-rule {
    height: 1px;
    background: var(--color-ink);
    opacity: 0.85;
    margin-bottom: var(--space-12);
  }
  .growth-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: var(--space-16);
    align-items: start;
  }
  .growth-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }
  .growth-sub {
    font-size: var(--text-sm);
    color: var(--color-line);
    margin-bottom: var(--space-10);
    letter-spacing: 0.04em;
  }
  .growth-chart {
    margin-top: var(--space-8);
  }
  .growth-chart svg {
    width: 100%;
    max-width: 320px;
    height: auto;
  }
  .growth-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-ink);
  }
  .growth-item {
    display: grid;
    grid-template-columns: 6.5rem 1fr 2rem;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }
  .growth-month {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-line);
    letter-spacing: 0.04em;
  }
  .growth-takeaway {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--color-ink);
  }
  .growth-arrow {
    color: var(--color-line);
    text-align: right;
    transition: color 0.2s;
  }
  .growth-item:hover .growth-arrow {
    color: var(--color-accent);
  }
  .right-arrow {
    color: var(--color-ink);
    opacity: 0.7;
    margin-left: var(--space-3);
  }
  @media (max-width: 820px) {
    .growth-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
  @media (max-width: 560px) {
    .growth-item {
      grid-template-columns: 5rem 1fr;
    }
    .growth-arrow {
      display: none;
    }
  }
</style>

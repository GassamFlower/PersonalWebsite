---
// Growth.astro — 档案 06 · 成长记录（左标题+黑白图 / 右月度列表）
import { getCollection } from 'astro:content';

const posts = (await getCollection('growth')).sort((a, b) =>
  a.data.month < b.data.month ? 1 : -1
);
---

<section id="growth" class="section growth">
  <div class="container">
    <div class="section-head">
      <span class="tag"><b>档案 06</b> · 成长记录</span>
      <span class="meta">06</span>
    </div>

    <div class="growth-grid">
      <div class="growth-left">
        <h2 class="section-title growth-title">公开的成长，<br />一个月记一次</h2>
        <p class="growth-sub">给自己一个每月进步的交代</p>
        <!-- 黑白柱状 + 趋势折线（参考图成长单色图） -->
        <div class="growth-chart" aria-hidden="true">
          <svg viewBox="0 0 300 190">
            <line x1="22" y1="160" x2="285" y2="160" stroke="var(--color-ink)" stroke-width="1"/>
            <line x1="22" y1="20" x2="22" y2="160" stroke="var(--color-ink)" stroke-width="1"/>
            <!-- 上升柱 -->
            <rect x="44"  y="150" width="16" height="10" opacity="0.35"/>
            <rect x="82"  y="150" width="16" height="34" opacity="0.45"/>
            <rect x="120" y="150" width="16" height="52" opacity="0.55"/>
            <rect x="158" y="150" width="16" height="72" opacity="0.7"/>
            <rect x="196" y="150" width="16" height="90" opacity="0.85"/>
            <rect x="234" y="150" width="16" height="112" opacity="1"/>
            <!-- 趋势折线 -->
            <polyline points="52,146 90,120 128,102 166,80 204,62 242,38"
              fill="none" stroke="var(--color-ink)" stroke-width="1.6"/>
            <circle cx="52" cy="146" r="3" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1"/>
            <circle cx="90" cy="120" r="3" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1"/>
            <circle cx="128" cy="102" r="3" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1"/>
            <circle cx="166" cy="80" r="3" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1"/>
            <circle cx="204" cy="62" r="3" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1"/>
            <circle cx="242" cy="38" r="3" fill="var(--color-base)" stroke="var(--color-ink)" stroke-width="1"/>
          </svg>
        </div>
        <nav class="growth-nav" aria-label="档案导航">
          <a href="#story">定位</a>
          <a href="#capability">方法</a>
          <a href="#cases">作品</a>
          <a href="#growth">记录</a>
          <a href="#contact">关于</a>
        </nav>
      </div>

      <div class="growth-list">
        {
          posts.map((p) => (
            <article class="growth-item">
              <span class="growth-month">{p.data.month}</span>
              <p class="growth-takeaway">{p.data.takeaway}</p>
              <span class="growth-arrow">→</span>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .growth-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: var(--space-16);
    align-items: start;
  }
  .growth-title {
    font-size: var(--text-3xl);
  }
  .growth-sub {
    font-size: var(--text-sm);
    color: var(--color-line);
    margin-bottom: var(--space-10);
  }
  .growth-chart {
    margin-top: var(--space-8);
  }
  .growth-chart svg {
    width: 100%;
    max-width: 300px;
    height: auto;
  }
  .growth-nav {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-10);
    flex-wrap: wrap;
  }
  .growth-nav a {
    font-size: var(--text-sm);
    color: var(--color-line);
    transition: color 0.2s;
  }
  .growth-nav a:hover {
    color: var(--color-ink);
  }
  .growth-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-ink);
  }
  .growth-item {
    display: grid;
    grid-template-columns: 6.5rem 1fr 2rem;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }
  .growth-month {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-line);
  }
  .growth-takeaway {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--color-ink);
  }
  .growth-arrow {
    color: var(--color-line);
    text-align: right;
    transition: color 0.2s;
  }
  .growth-item:hover .growth-arrow {
    color: #7a8f6d; /* 柔和橄榄灰绿 · 参考图成长强调 */
  }
  @media (max-width: 820px) {
    .growth-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
  @media (max-width: 560px) {
    .growth-item {
      grid-template-columns: 5rem 1fr;
    }
    .growth-arrow {
      display: none;
    }
  }
</style>
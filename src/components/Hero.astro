---
// Hero.astro — 档案 01 · 首屏定位
// 大字开门句 + 小字署名 + 克制入口，不立即摆技能。
const brand = '独立系统建构者';
const titleLine1 = '把复杂的事情';
const titleLine2 = '变成可以运行的系统。';
const subtitle = '8 年在真实系统里 · 工业数字化 · 全栈 · 真实交付';
const footerLinks = [
  { href: '#timeline', label: '独立交付 →' },
  { href: '#capability', label: '业务落地 →' },
  { href: '#contact', label: '边界诚实 →' },
];
---

<section id="hero" class="hero">
  <div class="container hero-inner">
    <p class="masthead-top">
      档案 01 · PERSONAL DOSSIER · {brand}
    </p>

    <h1 class="hero-title">
      {titleLine1}<br />
      <span>{titleLine2}</span>
    </h1>

    <p class="hero-sub">{subtitle}</p>

    <a class="hero-focus" href="#cases">
      <span class="hero-focus-dot"></span>
      精选作品 01—04 ↗
    </a>

    <hr class="hr-line hero-hr" />

    <nav class="hero-links" aria-label="目录入口">
      {
        footerLinks.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))
      }
    </nav>
  </div>
</section>

<style>
  .hero {
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding-block: var(--space-20);
  }
  .hero-inner {
    width: 100%;
  }
  .masthead-top {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-10);
  }
  .hero-title {
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.08;
    margin-bottom: var(--space-8);
    max-width: 14em;
  }
  .hero-title span {
    color: var(--color-ink);
  }
  .hero-sub {
    font-size: var(--text-lg);
    color: var(--color-line);
    max-width: 30em;
    margin-bottom: var(--space-12);
    line-height: 1.8;
  }
  .hero-focus {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    color: var(--color-accent);
    margin-bottom: var(--space-16);
    transition: color 0.2s;
    position: relative;
    z-index: 1;
  }
  .hero-focus:hover {
    color: var(--color-highlight);
  }
  .hero-focus-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-highlight);
    display: inline-block;
  }
  .hero-hr {
    margin-bottom: var(--space-6);
  }
  .hero-links {
    display: flex;
    gap: var(--space-10);
    flex-wrap: wrap;
  }
  .hero-links a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink);
    opacity: 0.7;
    letter-spacing: 0.04em;
    transition: opacity 0.2s, color 0.2s;
  }
  .hero-links a:hover {
    opacity: 1;
    color: var(--color-accent);
  }
</style>
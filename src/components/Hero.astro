---
// Hero.astro — 档案 01 · 首屏定位
// 超大衬线标题 + 右侧三张 UI 工作卡片 + 底部三列价值主张
const brand = '独立系统建构者';
const titleLine1 = '把复杂的事情，';
const titleLine2 = '变成可以运行的系统。';
const subtitle = '8 年在真实系统里 · 工业数字化 · 全栈 · 真实交付';
const props = [
  { href: '#capability', label: '独立交付' },
  { href: '#cases', label: '业务落地' },
  { href: '#principles', label: '边界诚实' },
];
---

<section id="hero" class="hero">
  <div class="container">
    <div class="section-head hero-head">
      <span class="tag">档案 01 · PERSONAL DOSSIER · {brand}</span>
      <span class="meta">DATE 2025-08-19<br />FILE NO. 001</span>
    </div>

    <h1 class="hero-title">
      {titleLine1}<br />{titleLine2}
    </h1>

    <div class="hero-mid">
      <div class="hero-left">
        <p class="hero-sub">{subtitle}</p>
        <a class="hero-focus" href="#cases">精选作品 01—04 ↗</a>
      </div>

      <div class="hero-shots" aria-hidden="true">
        <!-- 卡片 1：数据看板 -->
        <div class="ui-card">
          <svg viewBox="0 0 180 200">
            <text x="6" y="14" font-size="7" fill="var(--color-line)" font-family="monospace">ANALYTICS · 概览</text>
            <text x="6" y="50" font-size="26" font-weight="700" fill="var(--color-ink)">32</text>
            <text x="6" y="60" font-size="6" fill="var(--color-line)">设备总数</text>
            <text x="96" y="50" font-size="26" font-weight="700" fill="var(--color-ink)">98.6%</text>
            <text x="96" y="60" font-size="6" fill="var(--color-line)">在线率</text>
            <polyline points="6,120 34,104 62,112 90,92 118,98 146,80 174,86"
              fill="none" stroke="var(--color-accent)" stroke-width="1.5"/>
            <rect x="22" y="175" width="10" height="-30" fill="var(--color-accent)" opacity="0.25"/>
            <rect x="50" y="175" width="10" height="-46" fill="var(--color-accent)" opacity="0.4"/>
            <rect x="78" y="175" width="10" height="-38" fill="var(--color-accent)" opacity="0.55"/>
            <rect x="106" y="175" width="10" height="-58" fill="var(--color-accent)" opacity="0.7"/>
            <rect x="134" y="175" width="10" height="-50" fill="var(--color-accent)" opacity="0.85"/>
            <rect x="162" y="175" width="10" height="-68" fill="var(--color-accent)"/>
          </svg>
        </div>

        <!-- 卡片 2：新建工单 -->
        <div class="ui-card">
          <svg viewBox="0 0 180 200">
            <text x="6" y="14" font-size="7" fill="var(--color-line)" font-family="monospace">新建工单</text>
            <rect x="6" y="24" width="168" height="22" rx="2" fill="none" stroke="var(--color-faint)" stroke-width="1"/>
            <text x="10" y="38" font-size="7" fill="var(--color-line)">设备名称</text>
            <rect x="6" y="50" width="168" height="22" rx="2" fill="none" stroke="var(--color-faint)" stroke-width="1"/>
            <text x="10" y="64" font-size="7" fill="var(--color-line)">故障描述</text>
            <rect x="6" y="76" width="168" height="22" rx="2" fill="none" stroke="var(--color-faint)" stroke-width="1"/>
            <text x="10" y="90" font-size="7" fill="var(--color-line)">优先级</text>
            <rect x="6" y="102" width="168" height="22" rx="2" fill="none" stroke="var(--color-faint)" stroke-width="1"/>
            <text x="10" y="116" font-size="7" fill="var(--color-line)">负责人</text>
            <rect x="6" y="150" width="168" height="30" rx="3" fill="var(--color-accent)"/>
            <text x="70" y="170" font-size="10" fill="#fff">创建工单</text>
          </svg>
        </div>

        <!-- 卡片 3：数据列表 -->
        <div class="ui-card">
          <svg viewBox="0 0 180 200">
            <text x="6" y="14" font-size="7" fill="var(--color-line)" font-family="monospace">数据列表</text>
            <text x="6" y="34" font-size="6" fill="var(--color-line)">编号</text>
            <text x="46" y="34" font-size="6" fill="var(--color-line)">设备</text>
            <text x="98" y="34" font-size="6" fill="var(--color-line)">状态</text>
            <line x1="6" y1="40" x2="174" y2="40" stroke="var(--color-faint)" stroke-width="0.6"/>
            {[
              ['001','设备A','正常'],['002','设备B','告警'],['003','设备C','正常'],
              ['004','设备D','维护'],['005','设备E','正常'],
            ].map((r, i) => (
              <g key={i}>
                <text x="6" y={48 + i*26} font-size="7" fill="var(--color-ink)">{r[0]}</text>
                <text x="46" y={48 + i*26} font-size="7" fill="var(--color-ink)">{r[1]}</text>
                <circle cx={128} cy={45 + i*26} r="3" fill={r[2]==='正常'?'var(--color-accent)':r[2]==='告警'?'var(--color-gold)':'transparent'}
                  stroke={r[2]==='维护'?'var(--color-gold)':r[2]==='告警'?'none':'none'} stroke-width="1"/>
                <text x="100" y={48 + i*26} font-size="7" fill={r[2]==='告警'?'var(--color-gold)':'var(--color-line)'}>{r[2]}</text>
                <line x1="6" y1={54 + i*26} x2="174" y2={54 + i*26} stroke="var(--color-faint)" stroke-width="0.4"/>
              </g>
            ))}
          </svg>
        </div>
      </div>
    </div>

    <div class="hero-props">
      {
        props.map((p) => (
          <a class="hero-prop" href={p.href}>
            <span>{p.label}</span>
            <span class="prop-arrow">→</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-24);
  }
  .hero-head {
    margin-bottom: var(--space-16);
  }
  .hero-title {
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.06;
    margin-bottom: var(--space-16);
    max-width: 15em;
  }
  .hero-mid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: var(--space-16);
    align-items: center;
  }
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .hero-sub {
    font-size: var(--text-lg);
    color: var(--color-line);
    max-width: 24em;
    line-height: 1.9;
  }
  /* 精选作品 CTA —— 橄榄绿下划线（参考图首屏） */
  .hero-focus {
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    color: var(--color-accent);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-accent);
    width: fit-content;
    transition: opacity 0.2s;
  }
  .hero-focus:hover {
    opacity: 0.7;
  }
  /* 三张 UI 卡片 —— 圆角 + 柔和投影（参考图项目截图质感） */
  .hero-shots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    align-items: start;
  }
  .ui-card {
    background: #fffdf8;
    border: 1px solid var(--color-faint);
    border-radius: 6px;
    padding: var(--space-3);
    box-shadow: 0 8px 24px rgba(28, 27, 24, 0.08);
  }
  .ui-card:nth-child(2) {
    margin-top: var(--space-6);
  }
  .ui-card:nth-child(3) {
    margin-top: var(--space-12);
  }
  .ui-card svg {
    width: 100%;
    height: auto;
  }
  /* 底部三列价值主张，竖分隔 */
  .hero-props {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-ink);
    margin-top: var(--space-24);
  }
  .hero-prop {
    padding: var(--space-5) 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }
  .hero-prop + .hero-prop {
    border-left: 1px solid var(--color-ink);
    padding-left: var(--space-8);
  }
  .prop-arrow {
    color: var(--color-line);
    transition: color 0.2s;
  }
  .hero-prop:hover .prop-arrow {
    color: var(--color-accent);
  }
  @media (max-width: 980px) {
    .hero-mid {
      grid-template-columns: 1fr;
    }
    .hero-shots {
      max-width: 560px;
    }
    .ui-card:nth-child(2),
    .ui-card:nth-child(3) {
      margin-top: 0;
    }
  }
  @media (max-width: 640px) {
    .hero-props {
      grid-template-columns: 1fr;
    }
    .hero-prop + .hero-prop {
      border-left: none;
      border-top: 1px solid var(--color-ink);
      padding-left: 0;
    }
  }
</style>
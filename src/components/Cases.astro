---
// Cases.astro — 档案 04 · 项目案例（大编号 + 真实截图插槽）
//
// 【真实截图预留说明】
// 每个案例右侧是一个固定比例的截图槽位（无图时显示占位框）。
// 放入真实脱敏截图的方式：
//   1) 把图片放到 public/cases/case-0N.png（N 与 order 对应，01/02/03/04）
//   2) 在 src/content/cases/case-0N.md 的 frontmatter 里取消注释并修改：
//        image: /cases/case-01.png
//        imageAlt: 一句话说明
//   3) 存盘后即自动显示真实截图（object-fit: cover 铺满槽位）
// 槽位比例：case-01 为竖版手机屏 3:4，其余为横版界面屏 4:3。
// 截图尺寸建议：手机 924×1232 或更大；界面 1280×960 或更大（保证清晰）。
//
import { getCollection } from 'astro:content';

const cases = (await getCollection('cases', ({ data }) => data.published !== false))
  .sort((a, b) => a.data.order - b.data.order);
const statusBadge = { 已上线: '已上线 · 第 1 位', 内部系统: '内部系统', 开发中: '开发中' };
const statusTone = { 已上线: 'ok', 内部系统: 'ok', 开发中: 'wc' }; // 全部统一绿点，差异在文案
const ratios = ['portrait', 'landscape', 'landscape', 'landscape']; // 01 竖 / 02-04 横
---

<section id="cases" class="section cases">
  <div class="container">
    <div class="section-head">
      <span class="tag"><b>档案 04</b> · 项目案例（卷宗）</span>
      <span class="meta">04</span>
    </div>
    <h2 class="section-title">做的项目，能看能查</h2>

    <div class="case-list">
      {
        cases.map((c, i) => (
          <article class="case-card">
            <div class="case-info">
              <div class="case-head">
                <span class="case-no">0{i + 1}</span>
                <div>
                  <h3 class="case-title">{c.data.title}</h3>
                  <span class={`badge badge-${statusTone[c.data.status]}`}>{statusBadge[c.data.status]}</span>
                </div>
              </div>
              <p class="case-line"><b>问题</b>　{c.data.problem}</p>
              <p class="case-line"><b>解决</b>　{c.data.whatIDid}</p>
              {c.data.challenge && (
                <p class="case-line"><b>关键</b>　{c.data.challenge}</p>
              )}
              {c.data.outcome && (
                <p class="case-line case-outcome"><b>结果</b>　{c.data.outcome}</p>
              )}
              <p class="case-stack">
                {c.data.stack.join('　/　')}
              </p>
              <p class={`case-status status-${statusTone[c.data.status]}`}>
                <span class="status-dot"></span>{c.data.status}
              </p>
            </div>

            <div class="case-visual">
              {
                c.data.image ? (
                  <figure class={`shot shot-real shot-${ratios[i]}`}>
                    <img
                      class="frame-img"
                      src={c.data.image}
                      alt={c.data.imageAlt || `${c.data.title}截图`}
                      loading="lazy"
                    />
                  </figure>
                ) : (
                  <div class={`shot shot-slot shot-${ratios[i]}`}>
                    <span class="slot-type">
                      {i === 0 ? '示意 · 手机端流程' : '示意 · 界面功能线稿'}
                    </span>
                    <svg class="slot-schematic" viewBox="0 0 360 240" aria-hidden="true">
                      <g class="sch">
                        {/* 顶部标题条 */}
                        <rect x="18" y="16" width="324" height="22" rx="3" fill="none" stroke="var(--color-faint)" stroke-width="1"/>
                        <line x1="30" y1="27" x2="140" y2="27" stroke="var(--color-line)" stroke-width="1.4"/>
                        <circle cx="322" cy="27" r="3" fill="var(--color-accent)" opacity="0.7"/>
                        {i === 0 ? (
                          // case-01：手机端三栏登记/审批/记录流程
                          <g class="sch-flow">
                            <rect x="30" y="56" width="90" height="34" fill="none" stroke="var(--color-ink)" stroke-width="1.2"/>
                            <line x1="42" y1="73" x2="108" y2="73" stroke="var(--color-line)" stroke-width="0.8"/>
                            <rect x="30" y="150" width="90" height="34" fill="none" stroke="var(--color-ink)" stroke-width="1.2"/>
                            <line x1="42" y1="167" x2="108" y2="167" stroke="var(--color-line)" stroke-width="0.8"/>
                            <line x1="75" y1="90" x2="75" y2="150" stroke="var(--color-accent)" stroke-width="1" stroke-dasharray="4 3"/>
                            <rect x="236" y="56" width="104" height="122" rx="4" fill="none" stroke="var(--color-gold)" stroke-width="1.2"/>
                            <line x1="248" y1="72" x2="320" y2="72" stroke="var(--color-faint)" stroke-width="0.8"/>
                            <line x1="248" y1="140" x2="320" y2="140" stroke="var(--color-faint)" stroke-width="0.8"/>
                            <circle cx="248" cy="115" r="3" fill="var(--color-accent)" opacity="0.8"/>
                          </g>
                        ) : i === 1 ? (
                          // case-02 OPS: 多模块面板
                          <g class="sch">
                            <g class="sch-grid">
                              {[0,1,2].map(r => [0,1,2].map(c => (
                                <rect key={r+'-'+c} x={26+c*112} y={54+r*58} width="92" height="44" fill="none"
                                  stroke={r===0&&c===0 ? 'var(--color-accent)' : 'var(--color-faint)'} stroke-width="1"/>
                              )))}
                            </g>
                            <text x="26" y="40" font-family="var(--font-mono)" font-size="10" fill="var(--color-line)">资产 · 监控 · 巡检 · 工单</text>
                          </g>
                        ) : i === 2 ? (
                          // case-03 UUC: 收拢到统一中心
                          <g class="sch">
                            {[0,1,2,3].map(k => (
                              <rect key={k} x={26+k*64} y="56" width="48" height="26" rx="2" fill="none"
                                stroke="var(--color-faint)" stroke-width="1"/>
                            ))}
                            {[0,1,2,3].map(k => (
                              <line key={k} x1={44+k*90} y1={136} x2={150} y2={196}
                                stroke="var(--color-line)" stroke-width="0.8"/>
                            ))}
                            <circle cx="150" cy="196" r="22" fill="none" stroke="var(--color-accent)" stroke-width="1.4"/>
                            <text x="150" y="201" text-anchor="middle" font-family="var(--font-serif)" font-size="13" fill="var(--color-ink)">统一入口</text>
                          </g>
                        ) : (
                          // case-04 视频混剪: 输入→批次流水→输出
                          <g class="sch">
                            <rect x="26" y="70" width="70" height="44" rx="3" fill="none" stroke="var(--color-faint)" stroke-width="1.2"/>
                            <line x1="36" y1="92" x2="86" y2="92" stroke="var(--color-line)" stroke-width="0.8"/>
                            <rect x="250" y="70" width="84" height="44" rx="3" fill="none" stroke="var(--color-ink)" stroke-width="1.2"/>
                            <line x1="260" y1="92" x2="324" y2="92" stroke="var(--color-line)" stroke-width="0.8"/>
                            <line x1="96" y1="92" x2="250" y2="92" stroke="var(--color-accent)" stroke-width="1.2"/>
                            <polygon points="246,86 258,92 246,98" fill="var(--color-accent)"/>
                            <rect x="150" y="120" width="110" height="26" rx="2" fill="none" stroke="var(--color-gold)" stroke-width="1"/>
                            <line x1="164" y1="132" x2="250" y2="132" stroke="var(--color-faint)" stroke-width="0.8"/>
                          </g>
                        )}
                      </g>
                    </svg>
                    <span class="slot-hint">示意线稿 · 非真实截图</span>
                  </div>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .case-list {
    display: flex;
    flex-direction: column;
  }
  .case-card {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-10);
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  .case-card:last-child { border-bottom: 1px solid var(--color-line); }
  .case-head {
    display: flex;
    align-items: flex-end;
    gap: var(--space-6);
    margin-bottom: var(--space-5);
  }
  /* 铜金大编号 —— 参考图项目大编号 */
  .case-no {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    font-weight: 700;
    line-height: 0.85;
    color: var(--color-gold);
  }
  .case-title {
    font-size: 1.4rem;
    letter-spacing: 0.01em;
    line-height: 1.25;
    margin-bottom: var(--space-2);
  }
  .badge {
    display: inline-block;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-line);
    font-family: var(--font-sans);
  }
  .badge-ok { color: var(--color-line); }
  .badge-wc { color: var(--color-gold); }
  .case-line {
    font-size: var(--text-sm);
    line-height: 1.8;
    margin-bottom: var(--space-3);
    color: var(--color-ink);
  }
  .case-line b {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-gold);
    letter-spacing: 0.1em;
  }
  .case-stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-line);
    margin-top: var(--space-4);
    letter-spacing: 0.05em;
  }
  .case-status {
    margin-top: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .case-status .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    background: var(--color-accent);
  }
  .status-ok { color: var(--color-ink); }
  .status-ok .status-dot { background: var(--color-accent); }
  .status-wc { color: var(--color-gold); }
  .status-wc .status-dot { background: var(--color-gold); }

  /* ---- 截图槽位（真实截图铺满） ---- */
  .case-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .shot {
    width: 100%;
    max-width: 360px;
    background: var(--color-surface);
    border: 1px solid var(--color-faint);
    overflow: hidden;
    position: relative;
  }
  /* 比例：01 竖版 3:4，02-04 横版 4:3 */
  .shot-portrait { aspect-ratio: 3 / 4; }
  .shot-landscape { aspect-ratio: 4 / 3; }

  /* 真实截图 */
  .shot-real .frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 示意线稿占位（自绘 · 非真实截图，尊重匿名与诚实红线） */
  .shot-slot {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    border: 1.5px dashed var(--color-faint);
    color: var(--color-line);
    padding: var(--space-4);
    gap: var(--space-3);
  }
  .slot-type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-line);
    text-align: center;
  }
  .slot-schematic {
    width: 100%;
    height: auto;
    flex: 1 1 auto;
    min-height: 0;
  }
  .slot-hint {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-faint);
    text-align: center;
    letter-spacing: 0.05em;
  }
  .case-outcome b { color: var(--color-accent); }
  .case-outcome { color: var(--color-ink); }
  @media (max-width: 860px) {
    .case-card {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .case-no {
      font-size: var(--text-4xl);
    }
  }
  @media (max-width: 520px) {
    /* 手机端：编号与标题同处一行不喧宾夺主，截图槽位居中限宽 */
    .case-head {
      align-items: baseline;
      gap: var(--space-3);
    }
    .case-no { font-size: var(--text-3xl); }
    .case-title { font-size: var(--text-xl); margin-bottom: 0; }
    .shot { max-width: 300px; margin-inline: auto; }
    .case-info { grid-column: 1 / -1; }
    .case-card { padding-block: var(--space-6); }
  }
</style>
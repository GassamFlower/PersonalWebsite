---
// Cases.astro — 档案 · 项目案例（大编号 + 截图）
import { getCollection } from 'astro:content';

const cases = (await getCollection('cases', ({ data }) => data.published !== false))
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="cases" class="section cases">
  <div class="container">
    <p class="section-head"><span class="no">档案 04</span> · 项目案例（卷宗）</p>
    <h2 class="section-title">做的项目，能看能查</h2>
    <div class="case-list">
      {
        cases.map((c, i) => (
          <article class="case-card">
            <div class="case-info">
              <div class="case-head">
                <span class="case-no">0{i + 1}</span>
                <h3 class="case-title">{c.data.title}</h3>
                <span class={`badge badge-${c.data.status}`}>{c.data.status === '已上线' ? '（已上线，第 1 位）' : c.data.status === '内部系统' ? '' : `（${c.data.status}）`}</span>
              </div>
              <p class="case-problem">
                问题：{c.data.problem}
              </p>
              <p class="case-stack">
                技术栈：{c.data.stack.join(' / ')}
              </p>
              <p class="case-status-line">
                <span class="status-dot"></span>
                {c.data.status}
              </p>
            </div>
            <div class="case-visual">
              {
                c.data.image ? (
                  <img
                    class="case-img"
                    src={c.data.image}
                    alt={c.data.imageAlt || `${c.data.title}示意`}
                    loading="lazy"
                  />
                ) : (
                  <svg viewBox="0 0 400 300" role="img" aria-label={c.data.imageAlt || c.data.title}>
                    <rect x="1" y="1" width="398" height="298" fill="none" stroke="currentColor" stroke-width="1"/>
                    <line x1="40" y1="80" x2="360" y2="80" stroke="currentColor" stroke-width="0.5"/>
                    <line x1="40" y1="120" x2="320" y2="120" stroke="currentColor" stroke-width="0.5" opacity="0.5"/>
                    <line x1="40" y1="160" x2="360" y2="160" stroke="currentColor" stroke-width="0.5"/>
                    <line x1="40" y1="200" x2="300" y2="200" stroke="currentColor" stroke-width="0.5" opacity="0.5"/>
                  </svg>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cases {
    border-top: 1px solid var(--color-line);
  }
  .case-list {
    display: flex;
    flex-direction: column;
  }
  .case-card {
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-10);
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-10);
    align-items: start;
  }
  .case-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .case-no {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-highlight);
    letter-spacing: 0.02em;
    line-height: 1;
    min-width: 3rem;
  }
  .case-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .badge {
    font-size: var(--text-xs);
    color: var(--color-line);
    font-weight: 400;
  }
  .case-problem {
    color: var(--color-ink);
    margin-bottom: var(--space-3);
    line-height: 1.7;
    font-size: var(--text-sm);
  }
  .case-stack {
    color: var(--color-line);
    margin-bottom: var(--space-4);
    line-height: 1.7;
    font-size: var(--text-sm);
  }
  .case-status-line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    display: inline-block;
  }
  .case-visual {
    position: relative;
    color: var(--color-line);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-line);
    overflow: hidden;
    background: #fff;
  }
  .case-visual svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .case-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 800px) {
    .case-card {
      grid-template-columns: 1fr;
    }
    .case-no {
      font-size: var(--text-2xl);
    }
  }
</style>

---
// Cases.astro — 档案 · 项目案例（建筑事务所 Case Study / 卷宗）
// 真源驱动：读取 src/content/cases/ 的 md，按说服力排序（order）输出。
import { getCollection } from 'astro:content';

const cases = (await getCollection('cases', ({ data }) => data.published !== false))
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="cases" class="section cases">
  <div class="container">
    <p class="section-head"><span class="no">档案 04</span> 项目案例</p>
    <h2 class="section-title">做的项目，能看能查</h2>
    <div class="case-list">
      {
        cases.map((c, i) => (
          <article class="case-card">
            <div class="case-info">
              <div class="case-head">
                <span class="case-no">0{i + 1}</span>
                <span class={`badge badge-${c.data.status}`}>{c.data.status}</span>
              </div>
              <h3 class="case-title">{c.data.title}</h3>
              <p class="case-problem">
                <strong>问题 →</strong> {c.data.problem}
              </p>
              <p class="case-what">{c.data.whatIDid}</p>
              <p class="case-stack">
                {
                  c.data.stack.map((s) => <span class="tag">{s}</span>)
                }
              </p>
              {c.data.evidence && <p class="case-evidence">{c.data.evidence}</p>}
            </div>
            <div class="case-visual">
              {
                c.data.image ? (
                  <img
                    class="case-img"
                    src={c.data.image}
                    alt={c.data.imageAlt || `${c.data.title}示意`}
                    loading="lazy"
                  />
                ) : (
                  <>
                    <!-- 留白占位示意槽：4:3 细灰虚框 + 极淡工程线稿，不画真实截图 -->
                    <svg viewBox="0 0 400 300" role="img" aria-label={c.data.imageAlt || c.data.title}>
                      <rect x="1" y="1" width="398" height="298" fill="none" stroke="currentColor" stroke-width="2" />
                      <line x1="40" y1="80" x2="360" y2="80" stroke="currentColor" stroke-width="1" />
                      <line x1="40" y1="120" x2="320" y2="120" stroke="currentColor" stroke-width="1" opacity="0.5" />
                      <line x1="40" y1="160" x2="360" y2="160" stroke="currentColor" stroke-width="1" />
                      <line x1="40" y1="200" x2="300" y2="200" stroke="currentColor" stroke-width="1" opacity="0.5" />
                    </svg>
                    <span class="case-fig">{c.data.title}</span>
                  </>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
    <p class="cases-source-note">
      雇主与过程细节对公开版隐去 · 详询索取 ↘
    </p>
  </div>
</section>

<style>
  .cases {
    border-top: 1px solid var(--color-line);
  }
  .case-list {
    display: flex;
    flex-direction: column;
  }
  .case-card {
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-10);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }
  .case-no {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-highlight);
    letter-spacing: 0.06em;
    display: inline-block;
  }
  .case-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .case-title {
    font-size: var(--text-2xl);
    letter-spacing: 0.02em;
    margin-bottom: var(--space-4);
  }
  .case-problem {
    color: var(--color-ink);
    margin-bottom: var(--space-2);
    line-height: 1.7;
  }
  .case-problem strong {
    color: var(--color-accent);
    font-weight: 500;
  }
  .case-what {
    color: var(--color-line);
    margin-bottom: var(--space-4);
    line-height: 1.7;
    max-width: 34em;
  }
  .case-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
  .case-evidence {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-line);
    letter-spacing: 0.02em;
  }
  .case-visual {
    position: relative;
    color: var(--color-line);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-line);
    overflow: hidden;
    background: #fff;
  }
  .case-visual svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .case-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .case-fig {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cases-source-note {
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-line);
  }
  .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    vertical-align: middle;
    letter-spacing: 0.04em;
  }
  .badge-已上线 { color: var(--color-accent); }
  .badge-内部系统 { color: var(--color-line); }
  .badge-开发中 { color: var(--color-highlight); }
  @media (max-width: 800px) {
    .case-card {
      grid-template-columns: 1fr;
    }
  }
</style>
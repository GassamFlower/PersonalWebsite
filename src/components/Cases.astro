---
// Cases.astro — 档案 04 · 项目案例（大编号 + 真实截图插槽）
//
// 【真实截图预留说明】
// 每个案例右侧是一个固定比例的截图槽位（无图时显示占位框）。
// 放入真实脱敏截图的方式：
//   1) 把图片放到 public/cases/case-0N.png（N 与 order 对应，01/02/03/04）
//   2) 在 src/content/cases/case-0N.md 的 frontmatter 里取消注释并修改：
//        image: /cases/case-01.png
//        imageAlt: 一句话说明
//   3) 存盘后即自动显示真实截图（object-fit: cover 铺满槽位）
// 槽位比例：case-01 为竖版手机屏 3:4，其余为横版界面屏 4:3。
// 截图尺寸建议：手机 924×1232 或更大；界面 1280×960 或更大（保证清晰）。
//
import { getCollection } from 'astro:content';

const cases = (await getCollection('cases', ({ data }) => data.published !== false))
  .sort((a, b) => a.data.order - b.data.order);
const statusBadge = { 已上线: '已上线 · 第 1 位', 内部系统: '内部系统', 开发中: '开发中' };
const statusTone = { 已上线: 'ok', 内部系统: 'ok', 开发中: 'wc' }; // 全部统一绿点，差异在文案
const ratios = ['portrait', 'landscape', 'landscape', 'landscape']; // 01 竖 / 02-04 横
---

<section id="cases" class="section cases">
  <div class="container">
    <div class="section-head">
      <span class="tag"><b>档案 04</b> · 项目案例（卷宗）</span>
      <span class="meta">04</span>
    </div>
    <h2 class="section-title">做的项目，能看能查</h2>

    <div class="case-list">
      {
        cases.map((c, i) => (
          <article class="case-card">
            <div class="case-info">
              <div class="case-head">
                <span class="case-no">0{i + 1}</span>
                <div>
                  <h3 class="case-title">{c.data.title}</h3>
                  <span class={`badge badge-${statusTone[c.data.status]}`}>{statusBadge[c.data.status]}</span>
                </div>
              </div>
              <p class="case-line"><b>问题</b>　{c.data.problem}</p>
              <p class="case-line"><b>解决</b>　{c.data.whatIDid}</p>
              <p class="case-stack">
                {c.data.stack.join('　/　')}
              </p>
              <p class={`case-status status-${statusTone[c.data.status]}`}>
                <span class="status-dot"></span>{c.data.status}
              </p>
            </div>

            <div class="case-visual">
              {
                c.data.image ? (
                  <figure class={`shot shot-real shot-${ratios[i]}`}>
                    <img
                      class="frame-img"
                      src={c.data.image}
                      alt={c.data.imageAlt || `${c.data.title}截图`}
                      loading="lazy"
                    />
                  </figure>
                ) : (
                  <div class={`shot shot-slot shot-${ratios[i]}`}>
                    <span class="slot-type">
                      {i === 0 ? '手机截图 · 3:4' : '界面截图 · 4:3'}
                    </span>
                    <svg class="slot-cam" viewBox="0 0 40 30" aria-hidden="true">
                      <rect x="2" y="6" width="36" height="22" rx="2" fill="none" stroke="currentColor" stroke-width="1.3"/>
                      <polygon points="14,6 17,2 23,2 26,6" fill="none" stroke="currentColor" stroke-width="1.3"/>
                      <circle cx="20" cy="17" r="6" fill="none" stroke="currentColor" stroke-width="1.3"/>
                    </svg>
                    <span class="slot-label">截图槽位 0{i + 1}</span>
                    <span class="slot-hint">public/cases/case-0{i + 1}.png</span>
                  </div>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .case-list {
    display: flex;
    flex-direction: column;
  }
  .case-card {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-10);
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  .case-card:last-child { border-bottom: 1px solid var(--color-line); }
  .case-head {
    display: flex;
    align-items: flex-end;
    gap: var(--space-6);
    margin-bottom: var(--space-5);
  }
  /* 铜金大编号 —— 参考图项目大编号 */
  .case-no {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    font-weight: 700;
    line-height: 0.85;
    color: var(--color-gold);
  }
  .case-title {
    font-size: var(--text-2xl);
    letter-spacing: 0.01em;
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }
  .badge {
    display: inline-block;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-line);
    font-family: var(--font-sans);
  }
  .badge-ok { color: var(--color-line); }
  .badge-wc { color: var(--color-gold); }
  .case-line {
    font-size: var(--text-sm);
    line-height: 1.8;
    margin-bottom: var(--space-3);
    color: var(--color-ink);
  }
  .case-line b {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-gold);
    letter-spacing: 0.1em;
  }
  .case-stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-line);
    margin-top: var(--space-4);
    letter-spacing: 0.05em;
  }
  .case-status {
    margin-top: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  .case-status .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    background: var(--color-accent);
  }
  .status-ok { color: var(--color-ink); }
  .status-ok .status-dot { background: var(--color-accent); }
  .status-wc { color: var(--color-gold); }
  .status-wc .status-dot { background: var(--color-gold); }

  /* ---- 截图槽位（真实截图铺满） ---- */
  .case-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .shot {
    width: 100%;
    max-width: 360px;
    background: #fdfbf5;
    border: 1px solid var(--color-faint);
    overflow: hidden;
    position: relative;
  }
  /* 比例：01 竖版 3:4，02-04 横版 4:3 */
  .shot-portrait { aspect-ratio: 3 / 4; }
  .shot-landscape { aspect-ratio: 4 / 3; }

  /* 真实截图 */
  .shot-real .frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 占位框 */
  .shot-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    border: 1.5px dashed var(--color-faint);
    color: var(--color-line);
    text-align: center;
    padding: var(--space-4);
  }
  .slot-cam {
    width: 40px;
    height: auto;
    opacity: 0.7;
    margin-bottom: var(--space-1);
  }
  .slot-label {
    font-size: var(--text-sm);
    color: var(--color-ink);
    letter-spacing: 0.04em;
  }
  .slot-hint {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-line);
  }
  @media (max-width: 860px) {
    .case-card {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .case-no {
      font-size: var(--text-4xl);
    }
  }
  @media (max-width: 520px) {
    /* 手机端：编号与标题同处一行不喧宾夺主，截图槽位居中限宽 */
    .case-head {
      align-items: baseline;
      gap: var(--space-3);
    }
    .case-no { font-size: var(--text-3xl); }
    .case-title { font-size: var(--text-xl); margin-bottom: 0; }
    .shot { max-width: 300px; margin-inline: auto; }
    .case-info { grid-column: 1 / -1; }
    .case-card { padding-block: var(--space-6); }
  }
</style>
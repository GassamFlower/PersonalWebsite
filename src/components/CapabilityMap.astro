---
// CapabilityMap.astro — 档案 05 · 技能树（按技术栈领域分组，诚实三档分级 + 证据锚点）
// 主标题沿用特大衬线
// 每个领域一行：领域名 + 诚实等级徽章(已交付/会用/在学) + 技能点标签 + 一句证据
// 数据来自 src/content/skills/（内容即真源，宪法 §9），改内容只改这里
import { getCollection } from 'astro:content';

const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);

// 诚实三档徽章配色
const levelTone = {
  '已交付': 'done',
  '会用': 'use',
  '在学': 'learning',
};
const levelLabel = {
  '已交付': '已交付',
  '会用': '会用',
  '在学': '在学',
};
---

<section id="capability" class="section capability">
  <div class="container">
    <div class="section-head">
      <span class="tag"><b>档案 05</b> · 技能树</span>
      <span class="meta">05</span>
    </div>
    <div class="cap-rule"></div>

    <h2 class="cap-mega">技能档案：<br/>会什么，到什么程度</h2>

    <p class="cap-intro">
      按技术栈分领域，标出熟练程度与真实证据——不报菜名，边界诚实。
    </p>

    <div class="tree">
      {
        skills.map((s, i) => (
          <article class={`branch branch-${levelTone[s.data.level]}`}>
            <div class="branch-head">
              <span class="branch-no">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="branch-domain">{s.data.domain}</h3>
              <span class={`badge badge-${levelTone[s.data.level]}`}>{levelLabel[s.data.level]}</span>
            </div>

            <p class="branch-tagline">{s.data.tagline}</p>

            <ul class="branch-skills">
              {
                s.data.skills.map((k) => (
                  <li class="branch-skill">
                    <span class="skill-name">{k.name}</span>
                    {k.note ? <span class="skill-note">{k.note}</span> : null}
                  </li>
                ))
              }
            </ul>

            {
              s.data.evidence ? (
                <p class="branch-evidence"><b>证据</b>　{s.data.evidence}</p>
              ) : null
            }
          </article>
        ))
      }
    </div>

    <div class="cap-foot">
      <span>LEVEL 分级诚实标注</span>
      <span class="foot-sep">|</span>
      <span>ARCHIVE 0005</span>
      <span class="foot-sep">|</span>
      <span>PERSONAL DOSSIER</span>
    </div>
  </div>
</section>

<style>
  .cap-rule {
    height: 1px;
    background: var(--color-ink);
    opacity: 0.85;
    margin-bottom: var(--space-12);
  }
  .cap-mega {
    font-family: var(--font-serif);
    font-size: var(--text-mega);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    margin: 0 0 var(--space-6);
    text-wrap: balance;
  }
  .cap-intro {
    font-size: var(--text-base);
    color: var(--color-line);
    margin-bottom: var(--space-12);
    max-width: 40em;
    line-height: 1.8;
    letter-spacing: 0.02em;
  }

  .tree {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-ink);
  }
  .branch {
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-8);
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    column-gap: var(--space-6);
    row-gap: var(--space-3);
    align-items: start;
  }
  .branch-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }
  .branch-no {
    grid-column: 1 / 2;
    font-family: var(--font-serif);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 0.9;
    color: var(--color-gold);
  }
  .branch-domain {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.2;
    color: var(--color-ink);
  }
  .badge {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    padding: 0.15em 0.6em;
    border-radius: 2px;
    border: 1px solid;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .badge-done     { color: var(--color-ink); border-color: var(--color-ink); }
  .badge-use      { color: var(--color-accent); border-color: var(--color-accent); }
  .badge-learning { color: var(--color-gold); border-color: var(--color-gold); }

  .branch-tagline {
    grid-column: 2 / -1;
    font-size: var(--text-sm);
    color: var(--color-ink);
    opacity: 0.75;
    line-height: 1.7;
    margin-top: var(--space-1);
  }

  .branch-skills {
    grid-column: 2 / -1;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-6);
    padding: 0;
    margin: var(--space-1) 0 0;
  }
  .branch-skill {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 0.7em;
    align-items: baseline;
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .skill-name {
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }
  .skill-name::after {
    content: "——";
    color: var(--color-faint);
    font-weight: 400;
    margin-left: 0.45em;
  }
  .skill-note {
    color: var(--color-line);
    font-size: var(--text-sm);
  }

  .branch-evidence {
    grid-column: 2 / -1;
    font-size: var(--text-sm);
    color: var(--color-line);
    line-height: 1.7;
    margin-top: var(--space-1);
    letter-spacing: 0.02em;
  }
  .branch-evidence b {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-gold);
    letter-spacing: 0.1em;
    margin-right: 0.4em;
  }

  .cap-foot {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-16);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-line);
    letter-spacing: 0.12em;
    flex-wrap: wrap;
  }
  .foot-sep { color: var(--color-faint); }

  /* 移动端：单项纵向、无大小不一（收敛字号、统一列宽） */
  @media (max-width: 720px) {
    .branch {
      grid-template-columns: 48px minmax(0, 1fr);
      column-gap: var(--space-4);
      padding-block: var(--space-6);
    }
    .branch-no { font-size: 2.1rem; }
    .branch-head { flex-wrap: wrap; gap: var(--space-2); }
    .branch-domain { font-size: var(--text-xl); width: 100%; }
    .branch-skills { grid-template-columns: 1fr; gap: var(--space-2); }
    .branch-tagline,
    .branch-skills,
    .branch-evidence { grid-column: 2 / -1; }
  }
  @media (max-width: 400px) {
    .cap-mega { font-size: 2rem; }
    .branch { grid-template-columns: 40px minmax(0, 1fr); column-gap: var(--space-3); }
    .branch-no { font-size: 1.9rem; }
  }
</style>
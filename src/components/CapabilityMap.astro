---
// CapabilityMap.astro — 档案 05 · 四梯队能力地图（参考图 5）
// 主标题"边界清晰的自己"特大衬线
// 4 行：每行 01-04 大铜金编号（第3行 03 橄榄绿，权重最高）+ LEVEL xx/04 + 标题 + 描述 + 右侧小插图/工具卡
// 第3行右侧 3 张工具截图卡（AI编程/无忧饭/内容）
// 右侧 4 层等轴测文件柜（标注 01/02/03/04，第3层半拉出）
const tiers = [
  {
    no: '01', level: 'LEVEL 01 / 04', highlight: 'gold',
    title: '独立交付',
    desc: '从零搭建工业运维平台 / 外单微信小程序已上线交付 / 视频批量混剪工具。',
  },
  {
    no: '02', level: 'LEVEL 02 / 04', highlight: 'gold',
    title: '业务落地',
    desc: '政务系统 8 年数据与业务支持——数据服务、数据维护、SQL 报表、业务数据核对与分析、远程支持 / 批量内部自动化工具（日志 / 文件 / 爬虫 / 网页）。',
  },
  {
    no: '03', level: 'LEVEL 03 / 04', highlight: 'green',
    title: '工具与提效',
    desc: '智能体与 AI 编程工具实操面广（Trae / Cursor / Claude Code / Codex / DeepSeek Harness / CodeBuddy 等，用于开发与写作）；WordBuddy 写作公众号 / 小红书运营；Coze / Dify / n8n、ComfyUI 了解能数——诚实标注：实操面广、会用不称精通。',
  },
  {
    no: '04', level: 'LEVEL 04 / 04', highlight: 'gold',
    title: '边界诚实',
    desc: '数据库 / 网络运维 / Linux 能完成很多基础实用工作，深层专项在持续学习精进；数据治理在学、如实标注。',
  },
];
---

<section id="capability" class="section capability">
  <div class="container">
    <div class="section-head">
      <span class="tag"><b>档案 05</b> · 能力</span>
      <span class="meta">05</span>
    </div>
    <div class="cap-rule"></div>

    <h2 class="cap-mega">边界清晰的自己</h2>

    <div class="cap-grid">
      <div class="tier-list">
        <!-- LEVEL 01 独立交付 -->
        <article class="tier">
          <div class="tier-head">
            <span class={`tier-no tier-no-${tiers[0].highlight}`}>01</span>
            <span class="tier-level">{tiers[0].level}</span>
          </div>
          <div class="tier-mid">
            <h3 class="tier-title">{tiers[0].title}</h3>
            <p class="tier-desc">{tiers[0].desc}</p>
          </div>
          <div class="tier-art" aria-hidden="true">
            <svg viewBox="0 0 180 100" class="art-svg">
              <!-- 等轴测工业设备：底座 + 立柱 + 控制台 -->
              <polygon points="90,46 144,72 90,90 36,72" fill="none" stroke="var(--color-ink)" stroke-width="1.4"/>
              <polygon points="36,72 90,90 90,98 36,80" fill="none" stroke="var(--color-line)" stroke-width="1"/>
              <polygon points="144,72 90,90 90,98 144,80" fill="none" stroke="var(--color-line)" stroke-width="1"/>
              <!-- 立柱 -->
              <line x1="60" y1="36" x2="60" y2="68" stroke="var(--color-ink)" stroke-width="1.2"/>
              <line x1="120" y1="36" x2="120" y2="68" stroke="var(--color-ink)" stroke-width="1.2"/>
              <!-- 横梁 -->
              <line x1="56" y1="32" x2="124" y2="32" stroke="var(--color-ink)" stroke-width="1.2"/>
              <!-- 控制台按钮 -->
              <circle cx="90" cy="64" r="3" fill="var(--color-gold)"/>
              <line x1="70" y1="64" x2="80" y2="64" stroke="var(--color-faint)" stroke-width="0.6"/>
              <line x1="100" y1="64" x2="110" y2="64" stroke="var(--color-faint)" stroke-width="0.6"/>
            </svg>
          </div>
        </article>

        <!-- LEVEL 02 业务落地 -->
        <article class="tier">
          <div class="tier-head">
            <span class={`tier-no tier-no-${tiers[1].highlight}`}>02</span>
            <span class="tier-level">{tiers[1].level}</span>
          </div>
          <div class="tier-mid">
            <h3 class="tier-title">{tiers[1].title}</h3>
            <p class="tier-desc">{tiers[1].desc}</p>
          </div>
          <div class="tier-art" aria-hidden="true">
            <svg viewBox="0 0 180 100" class="art-svg">
              <!-- ER 关系：两张表 + 连线 + 中间节点 -->
              <rect x="10" y="22" width="56" height="60" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="1.2"/>
              <line x1="10" y1="34" x2="66" y2="34" stroke="var(--color-ink)" stroke-width="0.9"/>
              <line x1="16" y1="44" x2="56" y2="44" stroke="var(--color-faint)" stroke-width="0.6"/>
              <line x1="16" y1="54" x2="48" y2="54" stroke="var(--color-faint)" stroke-width="0.6"/>
              <line x1="16" y1="64" x2="60" y2="64" stroke="var(--color-faint)" stroke-width="0.6"/>
              <line x1="16" y1="74" x2="44" y2="74" stroke="var(--color-faint)" stroke-width="0.6"/>
              <rect x="114" y="22" width="56" height="60" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="1.2"/>
              <line x1="114" y1="34" x2="170" y2="34" stroke="var(--color-ink)" stroke-width="0.9"/>
              <line x1="120" y1="44" x2="160" y2="44" stroke="var(--color-faint)" stroke-width="0.6"/>
              <line x1="120" y1="54" x2="164" y2="54" stroke="var(--color-faint)" stroke-width="0.6"/>
              <line x1="120" y1="64" x2="152" y2="64" stroke="var(--color-faint)" stroke-width="0.6"/>
              <line x1="120" y1="74" x2="156" y2="74" stroke="var(--color-faint)" stroke-width="0.6"/>
              <!-- 关系连线 + 中间节点 -->
              <line x1="66" y1="52" x2="84" y2="52" stroke="var(--color-gold)" stroke-width="1"/>
              <line x1="96" y1="52" x2="114" y2="52" stroke="var(--color-gold)" stroke-width="1"/>
              <circle cx="90" cy="52" r="4" fill="var(--color-base)" stroke="var(--color-gold)" stroke-width="1.2"/>
              <text x="90" y="55" text-anchor="middle" font-size="6" fill="var(--color-gold)" font-family="monospace">N</text>
            </svg>
          </div>
        </article>

        <!-- LEVEL 03 工具与提效 —— 3 张工具截图卡 + 03 编号为橄榄绿（重点） -->
        <article class="tier tier-tools">
          <div class="tier-head">
            <span class="tier-no tier-no-green">03</span>
            <span class="tier-level">{tiers[2].level}</span>
          </div>
          <div class="tier-mid">
            <h3 class="tier-title">{tiers[2].title}</h3>
            <p class="tier-desc">{tiers[2].desc}</p>
          </div>
          <div class="tier-art" aria-hidden="true">
            <div class="tool-shots">
              <!-- 工具卡 1：AI 编程 / 智能体平台（IDE 风格截图） -->
              <div class="tool-card">
                <svg viewBox="0 0 160 110">
                  <rect x="2" y="2" width="156" height="106" rx="2" fill="#fdfbf5" stroke="var(--color-faint)" stroke-width="0.8"/>
                  <rect x="2" y="2" width="156" height="14" fill="#f5f0e8"/>
                  <line x1="2" y1="16" x2="158" y2="16" stroke="var(--color-faint)" stroke-width="0.6"/>
                  <circle cx="9" cy="9" r="1.4" fill="var(--color-faint)"/>
                  <circle cx="15" cy="9" r="1.4" fill="var(--color-faint)"/>
                  <circle cx="21" cy="9" r="1.4" fill="var(--color-faint)"/>
                  <!-- 左侧文件树 -->
                  <line x1="2" y1="16" x2="42" y2="16" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="42" y1="16" x2="42" y2="108" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="6" y1="26" x2="32" y2="26" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="6" y1="36" x2="38" y2="36" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="6" y1="46" x2="28" y2="46" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="6" y1="56" x2="36" y2="56" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="6" y1="66" x2="24" y2="66" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="6" y1="76" x2="34" y2="76" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="6" y1="86" x2="30" y2="86" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="6" y1="96" x2="38" y2="96" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <!-- 右侧代码行 -->
                  <line x1="48" y1="26" x2="80" y2="26" stroke="var(--color-line)" stroke-width="0.7"/>
                  <line x1="48" y1="36" x2="100" y2="36" stroke="var(--color-line)" stroke-width="0.7"/>
                  <line x1="48" y1="46" x2="120" y2="46" stroke="var(--color-accent)" stroke-width="1.2" stroke-opacity="0.5"/>
                  <line x1="48" y1="56" x2="90" y2="56" stroke="var(--color-line)" stroke-width="0.7"/>
                  <line x1="48" y1="66" x2="130" y2="66" stroke="var(--color-line)" stroke-width="0.7"/>
                  <line x1="48" y1="76" x2="76" y2="76" stroke="var(--color-line)" stroke-width="0.7"/>
                  <line x1="48" y1="86" x2="110" y2="86" stroke="var(--color-line)" stroke-width="0.7"/>
                  <line x1="48" y1="96" x2="96" y2="96" stroke="var(--color-line)" stroke-width="0.7"/>
                  <!-- 底部运行按钮 -->
                  <rect x="48" y="98" width="22" height="8" rx="1" fill="none" stroke="var(--color-ink)" stroke-width="0.6"/>
                </svg>
                <span class="tool-label">AI 编程 / 智能体平台</span>
              </div>

              <!-- 工具卡 2：无忧饭 / 自动化平台（流程节点） -->
              <div class="tool-card">
                <svg viewBox="0 0 160 110">
                  <rect x="2" y="2" width="156" height="106" rx="2" fill="#fdfbf5" stroke="var(--color-faint)" stroke-width="0.8"/>
                  <rect x="2" y="2" width="156" height="14" fill="#f5f0e8"/>
                  <line x1="2" y1="16" x2="158" y2="16" stroke="var(--color-faint)" stroke-width="0.6"/>
                  <circle cx="9" cy="9" r="1.4" fill="var(--color-faint)"/>
                  <circle cx="15" cy="9" r="1.4" fill="var(--color-faint)"/>
                  <circle cx="21" cy="9" r="1.4" fill="var(--color-faint)"/>
                  <!-- 流程节点（横向） -->
                  <rect x="10" y="30" width="22" height="14" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="0.9"/>
                  <line x1="32" y1="37" x2="46" y2="37" stroke="var(--color-line)" stroke-width="0.7"/>
                  <polygon points="44,34 49,37 44,40" fill="var(--color-line)"/>
                  <rect x="49" y="30" width="22" height="14" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="0.9"/>
                  <line x1="71" y1="37" x2="85" y2="37" stroke="var(--color-line)" stroke-width="0.7"/>
                  <polygon points="83,34 88,37 83,40" fill="var(--color-line)"/>
                  <rect x="88" y="30" width="22" height="14" rx="2" fill="none" stroke="var(--color-accent)" stroke-width="1.1"/>
                  <line x1="110" y1="37" x2="124" y2="37" stroke="var(--color-line)" stroke-width="0.7"/>
                  <polygon points="122,34 127,37 122,40" fill="var(--color-line)"/>
                  <rect x="127" y="30" width="22" height="14" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="0.9"/>
                  <!-- 列表区 -->
                  <line x1="10" y1="58" x2="150" y2="58" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="10" y1="68" x2="140" y2="68" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="10" y1="78" x2="130" y2="78" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="10" y1="88" x2="150" y2="88" stroke="var(--color-faint)" stroke-width="0.4"/>
                  <line x1="10" y1="98" x2="120" y2="98" stroke="var(--color-faint)" stroke-width="0.4"/>
                </svg>
                <span class="tool-label">无忧饭 / 自动化平台</span>
              </div>

              <!-- 工具卡 3：内容 / 写作工具（文档列表） -->
              <div class="tool-card">
                <svg viewBox="0 0 160 110">
                  <rect x="2" y="2" width="156" height="106" rx="2" fill="#fdfbf5" stroke="var(--color-faint)" stroke-width="0.8"/>
                  <rect x="2" y="2" width="156" height="14" fill="#f5f0e8"/>
                  <line x1="2" y1="16" x2="158" y2="16" stroke="var(--color-faint)" stroke-width="0.6"/>
                  <circle cx="9" cy="9" r="1.4" fill="var(--color-faint)"/>
                  <circle cx="15" cy="9" r="1.4" fill="var(--color-faint)"/>
                  <circle cx="21" cy="9" r="1.4" fill="var(--color-faint)"/>
                  <!-- 左侧文章卡（大） -->
                  <rect x="10" y="22" width="60" height="78" rx="1" fill="none" stroke="var(--color-ink)" stroke-width="0.8"/>
                  <line x1="16" y1="34" x2="62" y2="34" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <line x1="16" y1="42" x2="56" y2="42" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <line x1="16" y1="50" x2="64" y2="50" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <line x1="16" y1="58" x2="48" y2="58" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <line x1="16" y1="66" x2="60" y2="66" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <line x1="16" y1="74" x2="52" y2="74" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <line x1="16" y1="82" x2="56" y2="82" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <line x1="16" y1="90" x2="40" y2="90" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <!-- 右侧两个小卡 -->
                  <rect x="78" y="22" width="70" height="36" rx="1" fill="none" stroke="var(--color-ink)" stroke-width="0.8"/>
                  <line x1="84" y1="32" x2="142" y2="32" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <line x1="84" y1="40" x2="134" y2="40" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <line x1="84" y1="48" x2="120" y2="48" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <rect x="78" y="64" width="70" height="36" rx="1" fill="none" stroke="var(--color-faint)" stroke-width="0.8"/>
                  <line x1="84" y1="74" x2="138" y2="74" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <line x1="84" y1="82" x2="128" y2="82" stroke="var(--color-faint)" stroke-width="0.5"/>
                  <line x1="84" y1="90" x2="118" y2="90" stroke="var(--color-faint)" stroke-width="0.5"/>
                </svg>
                <span class="tool-label">内容 / 写作工具</span>
              </div>
            </div>
          </div>
        </article>

        <!-- LEVEL 04 边界诚实 -->
        <article class="tier">
          <div class="tier-head">
            <span class={`tier-no tier-no-${tiers[3].highlight}`}>04</span>
            <span class="tier-level">{tiers[3].level}</span>
          </div>
          <div class="tier-mid">
            <h3 class="tier-title">{tiers[3].title}</h3>
            <p class="tier-desc">{tiers[3].desc}</p>
          </div>
          <div class="tier-art" aria-hidden="true">
            <svg viewBox="0 0 180 100" class="art-svg">
              <!-- 基础表格网格（5x4） -->
              <rect x="10" y="20" width="160" height="68" fill="none" stroke="var(--color-ink)" stroke-width="1.2"/>
              <line x1="10" y1="36" x2="170" y2="36" stroke="var(--color-ink)" stroke-width="0.9"/>
              <line x1="10" y1="52" x2="170" y2="52" stroke="var(--color-faint)" stroke-width="0.5"/>
              <line x1="10" y1="68" x2="170" y2="68" stroke="var(--color-faint)" stroke-width="0.5"/>
              <line x1="42"  y1="20" x2="42"  y2="88" stroke="var(--color-faint)" stroke-width="0.5"/>
              <line x1="74"  y1="20" x2="74"  y2="88" stroke="var(--color-faint)" stroke-width="0.5"/>
              <line x1="106" y1="20" x2="106" y2="88" stroke="var(--color-faint)" stroke-width="0.5"/>
              <line x1="138" y1="20" x2="138" y2="88" stroke="var(--color-faint)" stroke-width="0.5"/>
            </svg>
          </div>
        </article>
      </div>

      <!-- 右侧 4 层等轴测文件柜（更精致） -->
      <aside class="cabinet" aria-hidden="true">
        <svg viewBox="0 0 240 540" class="cabinet-svg">
          <!-- 顶部基准虚线 + 中心线 -->
          <line x1="20" y1="14" x2="220" y2="14" stroke="var(--color-faint)" stroke-width="0.5" stroke-dasharray="3 3"/>
          <line x1="120" y1="14" x2="120" y2="526" stroke="var(--color-faint)" stroke-width="0.5" stroke-dasharray="6 1 1 1"/>
          <!-- 柜体底座 -->
          <line x1="30" y1="510" x2="210" y2="510" stroke="var(--color-ink)" stroke-width="1"/>
          <line x1="40" y1="510" x2="40" y2="520" stroke="var(--color-faint)" stroke-width="0.5"/>
          <line x1="80" y1="510" x2="80" y2="520" stroke="var(--color-faint)" stroke-width="0.5"/>
          <line x1="120" y1="510" x2="120" y2="520" stroke="var(--color-faint)" stroke-width="0.5"/>
          <line x1="160" y1="510" x2="160" y2="520" stroke="var(--color-faint)" stroke-width="0.5"/>
          <line x1="200" y1="510" x2="200" y2="520" stroke="var(--color-faint)" stroke-width="0.5"/>
          <!-- 柜体 -->
          <rect x="36" y="24" width="168" height="488" rx="4" fill="none" stroke="var(--color-ink)" stroke-width="2"/>

          <!-- 抽屉 1 -->
          <rect x="44" y="36" width="152" height="108" rx="2" fill="none" stroke="var(--color-line)" stroke-width="1.2"/>
          <rect x="100" y="80" width="40" height="8" rx="2" fill="none" stroke="var(--color-line)" stroke-width="1"/>
          <rect x="104" y="84" width="32" height="0" fill="var(--color-line)"/>
          <text x="172" y="92" font-size="14" fill="var(--color-gold)" font-family="serif" font-weight="700">01</text>

          <!-- 抽屉 2 -->
          <rect x="44" y="148" width="152" height="108" rx="2" fill="none" stroke="var(--color-line)" stroke-width="1.2"/>
          <rect x="100" y="192" width="40" height="8" rx="2" fill="none" stroke="var(--color-line)" stroke-width="1"/>
          <text x="172" y="204" font-size="14" fill="var(--color-gold)" font-family="serif" font-weight="700">02</text>

          <!-- 抽屉 3（拉开，露出文件） -->
          <rect x="50" y="260" width="140" height="108" rx="2" fill="none" stroke="var(--color-ink)" stroke-width="1.6"/>
          <!-- 拉出抽屉内的文件 -->
          <rect x="58" y="268" width="6" height="92" rx="0.5" fill="none" stroke="var(--color-faint)" stroke-width="0.8"/>
          <rect x="68" y="270" width="6" height="88" rx="0.5" fill="none" stroke="var(--color-line)" stroke-width="0.8"/>
          <rect x="78" y="266" width="6" height="94" rx="0.5" fill="none" stroke="var(--color-line)" stroke-width="0.8"/>
          <rect x="88" y="270" width="6" height="88" rx="0.5" fill="none" stroke="var(--color-faint)" stroke-width="0.8"/>
          <rect x="98" y="268" width="6" height="92" rx="0.5" fill="none" stroke="var(--color-line)" stroke-width="0.8"/>
          <rect x="108" y="266" width="6" height="94" rx="0.5" fill="none" stroke="var(--color-accent)" stroke-width="1.4"/>
          <rect x="118" y="270" width="6" height="88" rx="0.5" fill="none" stroke="var(--color-faint)" stroke-width="0.8"/>
          <rect x="128" y="268" width="6" height="92" rx="0.5" fill="none" stroke="var(--color-line)" stroke-width="0.8"/>
          <rect x="138" y="266" width="6" height="94" rx="0.5" fill="none" stroke="var(--color-faint)" stroke-width="0.8"/>
          <rect x="148" y="270" width="6" height="88" rx="0.5" fill="none" stroke="var(--color-line)" stroke-width="0.8"/>
          <rect x="158" y="268" width="6" height="92" rx="0.5" fill="none" stroke="var(--color-faint)" stroke-width="0.8"/>
          <rect x="168" y="270" width="6" height="88" rx="0.5" fill="none" stroke="var(--color-line)" stroke-width="0.8"/>
          <!-- 把手 -->
          <rect x="104" y="330" width="32" height="6" rx="1.5" fill="none" stroke="var(--color-ink)" stroke-width="1.2"/>
          <text x="178" y="318" font-size="14" fill="var(--color-gold)" font-family="serif" font-weight="700">03</text>

          <!-- 抽屉 4 -->

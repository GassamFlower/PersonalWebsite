---
// Base.astro — 全局布局：head / 字体 / 导航 / 背景 / 骨架
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title?: string;
}

const { title = 'PERSONAL DOSSIER · 独立交付档案' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="把一团乱麻，理成能用的系统 —— 独立系统建构者的公开交付档案。"
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Serif+SC:wght@500;600;700&display=swap"
    />
  </head>
  <body>
    <SiteNav />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-note">展示内容均经匿名化脱敏，不涉及具体公司 / 客户信息</p>
        <p class="footer-tag">把一团乱麻，理成能用的系统 · PERSONAL DOSSIER</p>
        <span class="footer-mark" aria-hidden="true">
          <svg viewBox="0 0 28 28">
            <rect x="1.5" y="1.5" width="25" height="25" fill="none" stroke="var(--color-ink)" stroke-width="1.2"/>
            <path d="M8 21 C 8 12, 14 7, 14 7 " fill="none" stroke="var(--color-ink)" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M14 7 C 17 14, 20 18, 20 21" fill="none" stroke="var(--color-gold)" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="14" y1="8" x2="9" y2="16" stroke="var(--color-gold)" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    border-top: 1px solid var(--color-ink);
    padding-block: var(--space-5);
    margin-top: var(--space-16);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--text-xs);
    color: var(--color-line);
    letter-spacing: 0.06em;
  }
  .footer-tag {
    color: var(--color-accent);
    font-family: var(--font-serif);
    white-space: nowrap;
  }
  .footer-mark {
    display: block;
    width: 26px;
    height: 26px;
  }
  .footer-mark svg {
    width: 100%;
    height: 100%;
  }
  @media (max-width: 820px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      text-align: center;
      justify-items: center;
    }
  }
</style>

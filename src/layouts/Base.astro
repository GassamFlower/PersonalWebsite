---
// Base.astro — 全局布局：head / 字体 / 导航 / 背景 / 骨架
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title?: string;
}

const { title = 'PERSONAL DOSSIER · 独立交付档案' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="把一团乱麻，理成能用的系统 —— 独立系统建构者的公开交付档案。"
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 分享卡片：微信/钉钉只读绝对 URL，故 og:image 不用 base 相对路径。
         图由 scripts/og_image.py 绘制（AI 生图会产出假汉字，踩诚实红线）。 -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="PERSONAL DOSSIER" />
    <meta property="og:url" content="https://gassamflower.github.io/PersonalWebsite/" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="把一团乱麻，理成能用的系统 —— 独立系统建构者的公开交付档案。"
    />
    <meta property="og:image" content="https://gassamflower.github.io/PersonalWebsite/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="纸白底、墨黑细线与裁切线的档案封面卡片，右下一枚朱砂署名章。" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- 字体自托管：见 assets/fonts/fonts.css（Google Fonts 在大陆网络不可达） -->
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <SiteNav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-note">展示内容均经匿名化脱敏，不涉及具体公司 / 客户信息</p>
        <p class="footer-tag">把一团乱麻，理成能用的系统 · PERSONAL DOSSIER</p>
        <span class="footer-mark" aria-hidden="true">
          <svg viewBox="0 0 28 28">
            <rect x="1.5" y="1.5" width="25" height="25" fill="none" stroke="var(--color-ink)" stroke-width="1.2"/>
            <path d="M8 21 C 8 12, 14 7, 14 7 " fill="none" stroke="var(--color-ink)" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M14 7 C 17 14, 20 18, 20 21" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="14" y1="8" x2="9" y2="16" stroke="var(--color-accent)" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </span>
      </div>
    </footer>
  </body>
</html>

<script>
  // 轻动效 fade-up（架构门 §7：克制、尊重 prefers-reduced-motion）
  // JS 未执行或用户偏好减弱动效时，内容始终完整可见。
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;
    const els = document.querySelectorAll('.section');
    if (!els.length) return;
    els.forEach((el) => el.classList.add('reveal'));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.1 }
    );
    els.forEach((el) => io.observe(el));
  })();
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--color-ink);
    padding-block: var(--space-5);
    margin-top: var(--space-16);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--space-8);
    font-size: var(--text-xs);
    color: var(--color-line);
    letter-spacing: 0.06em;
  }
  .footer-tag {
    color: var(--color-accent);
    font-family: var(--font-serif);
    white-space: nowrap;
  }
  .footer-mark {
    display: block;
    width: 26px;
    height: 26px;
  }
  .footer-mark svg {
    width: 100%;
    height: 100%;
  }
  @media (max-width: 820px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      text-align: center;
      justify-items: center;
    }
  }
</style>

---
// Base.astro — 全局布局：head / 字体 / 导航 / 背景 / 骨架
// 依据 docs/视觉方向-v3-架构门.md + docs/e-架构设计文档.md
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title?: string;
}

const { title = 'PERSONAL DOSSIER · 独立交付档案' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="把一团乱麻，理成能用的系统 —— 独立系统建构者的公开交付档案。"
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 衬线中文标题字体（可加载本地子集/在线） -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Serif+SC:wght@500;600;700&display=swap"
    />
  </head>
  <body>
    <SiteNav />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-note">
          展示内容均经匿名化脱敏，不涉及具体公司 / 客户信息
        </p>
        <p class="footer-tag">把一团乱麻，理成能用的系统 · PERSONAL DOSSIER</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-6);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--color-line);
    letter-spacing: 0.06em;
  }
  .footer-tag {
    color: var(--color-accent);
    font-family: var(--font-serif);
  }
</style>